{%- liquid
  assign product = closest.product
  assign feature_descriptions = product.metafields.custom.product_feature_description.value
  assign feature_icons = product.metafields.custom.product_feature_icon.value
-%}

{%- if feature_descriptions != blank -%}
  <div class="product-features" {{ block.shopify_attributes }}>
    <ul class="product-features__list" role="list">
      {%- for description in feature_descriptions -%}
        {%- assign feature_icon = feature_icons[forloop.index0] -%}
        <li class="product-features__item">
          {%- if feature_icon != blank -%}
            {%- if feature_icon.preview_image != blank -%}
              {{
                feature_icon.preview_image
                | image_url: width: 192
                | image_tag:
                  class: 'product-features__icon',
                  widths: '48, 72, 96, 144, 192',
                  sizes: '48px',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- elsif feature_icon.url != blank -%}
              <img
                class="product-features__icon"
                src="{{ feature_icon.url | escape }}"
                alt=""
                width="48"
                height="48"
                loading="lazy"
              >
            {%- endif -%}
          {%- endif -%}

          <p class="product-features__description">{{ description | escape | newline_to_br }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-features {
    width: 100%;
  }

  .product-features__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: var(--padding-lg);
    color: var(--color-foreground);
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-lg);
    list-style: none;
    overflow: hidden;
  }

  .product-features__item {
    display: grid;
    min-width: 0;
    align-content: start;
    justify-items: center;
    gap: var(--gap-sm);
    padding: var(--padding-lg) var(--padding-xs);
    text-align: center;
  }

  .product-features__item:nth-child(even) {
    border-inline-start: var(--style-border-width) solid var(--color-border);
  }

  .product-features__icon {
    display: block;
    width: calc(var(--padding-xl) * 2);
    height: calc(var(--padding-xl) * 2);
    object-fit: contain;
  }

  .product-features__description {
    margin: 0;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--lg);
    line-height: var(--font-paragraph--line-height);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  @media (min-width: 750px) {
    .product-features__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: var(--padding-xl);
    }

    .product-features__item {
      align-content: center;
      gap: var(--gap-lg);
      padding: var(--padding-xl) var(--padding-lg);
    }

    .product-features__item:nth-child(n) {
      border-inline-start: var(--style-border-width) solid var(--color-border);
    }

    .product-features__item:nth-child(4n + 1) {
      border-inline-start: 0;
    }

    .product-features__icon {
      width: calc(var(--padding-2xl) * 2);
      height: calc(var(--padding-2xl) * 2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product features",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Product features"
    }
  ]
}
{% endschema %}
