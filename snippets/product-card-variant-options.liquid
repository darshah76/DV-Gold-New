{%- doc -%}
  Renders the canonical text-pill variant selector for a product card.

  Product cards expose the first product option. Products with additional options
  continue through the shared quick-add dialog so every purchasable combination
  remains accessible.

  @param {object} product - Product displayed by the card.
{%- enddoc -%}

{% assign product_option = product.options_with_values | first %}

{% if product_option != blank %}
  <div class="product-card__variant-options">
    <swatches-variant-picker-component
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      data-product-handle="{{ product.handle }}"
      data-product-title="{{ product.title | escape }}"
      ref="swatchesVariantPicker"
    >
      <form>
        <fieldset class="product-card__variant-list">
          <legend class="visually-hidden">{{ product_option.name }}</legend>
          {% for product_option_value in product_option.values %}
            {% liquid
              assign option_value_variant = product_option_value.variant
              assign first_available_variant = nil
              assign option_key = 'option' | append: product_option.position

              if option_value_variant.available
                assign first_available_variant = option_value_variant
              endif

              if first_available_variant == blank
                for variant in product.variants
                  if variant.available and variant[option_key] == product_option_value.name
                    assign first_available_variant = variant
                    break
                  endif
                endfor
              endif

              assign variant_for_value = first_available_variant | default: option_value_variant
              assign is_selected = product_option_value.selected
              if product.selected_variant == blank and forloop.first
                assign is_selected = true
              endif
            %}
            <label class="product-card__variant-label">
              <input
                class="visually-hidden"
                type="radio"
                name="{{ product_option.name | escape }}-{{ product.id }}-card"
                value="{{ product_option_value.name | escape }}"
                aria-label="{{ product_option_value.name | escape }}"
                data-option-name="{{ product_option.name | escape }}"
                data-option-value-id="{{ product_option_value.id }}"
                data-option-available="{{ product_option_value.available }}"
                data-variant-id="{{ variant_for_value.id }}"
                data-first-available-or-first-variant-id="{{ variant_for_value.id }}"
                data-connected-product-url="{{ product_option_value.product_url }}"
                {% if is_selected %}checked{% endif %}
              >
              <span>{{ product_option_value.name }}</span>
            </label>
          {% endfor %}
        </fieldset>
        <script type="application/json">
          {{ product.selected_or_first_available_variant | json }}
        </script>
      </form>
    </swatches-variant-picker-component>
  </div>
{% endif %}
