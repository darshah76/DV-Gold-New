{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  :root {
    --product-card-gutter: var(--padding-lg, 16px);
  }

  @media screen and (max-width: 749px) {
    :root {
      --product-card-gutter: 10px;
    }
  }

  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--gap-sm);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: 0;
    overflow: hidden;
    position: relative;
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: 20px;
    padding-block-end: var(--product-card-gutter);
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .product-card {
    overflow: hidden;
    border-radius: var(--style-border-radius-cards);
    min-width: 0;
  }

  .product-card .product-card__content > :not(:first-child) {
    margin-inline: var(--product-card-gutter) !important;
    width: calc(100% - (var(--product-card-gutter) * 2)) !important;
    max-width: calc(100% - (var(--product-card-gutter) * 2)) !important;
    box-sizing: border-box !important;
  }

  .product-card .product-card__content a[ref="productTitleLink"],
  .product-card .product-card__content > a {
    display: block !important;
    width: calc(100% - (var(--product-card-gutter) * 2)) !important;
    max-width: calc(100% - (var(--product-card-gutter) * 2)) !important;
    margin-inline: var(--product-card-gutter) !important;
    box-sizing: border-box !important;
    text-align: left !important;
  }

  .product-card .product-card__content a[ref="productTitleLink"] .text-block,
  .product-card .product-card__content > a .text-block,
  .product-card .product-card__content > .text-block {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    text-align: left !important;
    align-items: flex-start !important;
    justify-content: flex-start !important;
    align-self: flex-start !important;
    --text-align: left !important;
    --text-align-default: left !important;
  }

  .product-card .product-card__content a[ref="productTitleLink"] :is([role='heading'], .text-block p, h1, h2, h3, h4, h5, h6, *),
  .product-card .product-card__content > a :is([role='heading'], .text-block p, h1, h2, h3, h4, h5, h6, *),
  .product-card .product-card__content > .text-block :is([role='heading'], .text-block p, h1, h2, h3, h4, h5, h6, *) {
    text-align: left !important;
    align-self: flex-start !important;
    margin-inline-start: 0 !important;
    margin-inline-end: auto !important;
  }

  .product-card .product-card__content > :first-child {
    margin-block-end: var(--padding-sm);
  }

  .product-card .product-card__content > :is(product-swatches, .product-card__variant-options) {
    order: 3;
  }

  .product-card .product-card__content > product-swatches {
    display: none;
  }

  .product-card .product-card__content > product-price {
    order: 4;
  }

  .product-card .product-card__content > .quick-add {
    order: 5;
    margin-top: auto;
  }

  .product-card__variant-options {
    width: calc(100% - (var(--product-card-gutter) * 2));
    max-width: calc(100% - (var(--product-card-gutter) * 2));
    box-sizing: border-box;
  }

  .product-card__variant-options swatches-variant-picker-component,
  .product-card__variant-options form {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .product-card__variant-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs, 6px);
    min-width: 0;
    max-width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .product-card__variant-label {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    min-width: 0;
  }

  .product-card__variant-label input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .product-card__variant-label span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--minimum-touch-target);
    padding-inline: var(--padding-md);
    border: var(--style-border-width) solid var(--color-primary-button-border);
    border-radius: var(--variant-picker-button-radius);
    background: var(--color-variant-background);
    color: var(--color-variant-text);
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    cursor: pointer;
    box-sizing: border-box;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .product-card__variant-label span {
      min-block-size: 30px;
      padding-inline: var(--padding-xs, 8px);
      font-size: var(--font-size--xs, 0.75rem);
    }
  }

  .product-card__variant-label input:checked + span {
    border-color: var(--color-primary-button-border);
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .product-card__variant-label input:focus-visible + span {
    outline: var(--focus-outline-width) solid currentColor;
    outline-offset: var(--focus-outline-offset);
  }

  .product-card__variant-label input[data-option-available='false'] + span {
    opacity: var(--opacity-muted-text);
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .product-card .product-card__content :is([role='heading'], product-price) {
    color: var(--color-foreground);
  }

  .product-card .product-card__content [role='heading'] {
    color: var(--color-primary-button-background);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-h4--size);
    line-height: var(--font-h4--line-height);
    letter-spacing: var(--font-h4--letter-spacing);
  }

  .product-card .product-card__content product-price,
  .product-card .product-card__content > product-price.text-block {
    display: block !important;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-paragraph--size);
    line-height: normal;
    letter-spacing: normal;
    width: calc(100% - (var(--product-card-gutter) * 2)) !important;
    max-width: calc(100% - (var(--product-card-gutter) * 2)) !important;
    margin-inline: var(--product-card-gutter) !important;
    box-sizing: border-box !important;
  }

  .product-card .product-card__content product-price [ref='priceContainer'] {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px var(--gap-xs, 6px);
    min-width: 0;
    max-width: 100%;
    line-height: normal;
  }

  .product-card .product-card__content product-price.text-center [ref='priceContainer'],
  .product-card .product-card__content product-price.text-block--align-center [ref='priceContainer'] {
    justify-content: center;
  }

  .product-card .product-card__content product-price .price {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight, 600);
    font-size: var(--font-size--md, 1rem);
    line-height: 1.2;
    color: var(--color-foreground);
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
  }

  .product-card .product-card__content product-price .compare-at-price {
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight, 500);
    font-size: var(--font-size--sm, 0.875rem);
    line-height: 1.2;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.6));
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgb(var(--color-foreground-rgb) / var(--opacity-30, 0.3));
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
  }

  @media screen and (max-width: 749px) {
    .product-card .product-card__content product-price .price {
      font-size: var(--font-size--sm, 0.875rem);
      line-height: 1.2;
    }

    .product-card .product-card__content product-price .compare-at-price {
      font-size: var(--font-size--2xs, 0.75rem);
      line-height: 1.2;
    }
  }

  .product-card .card-gallery {
    --gallery-aspect-ratio: 1;
    background: var(--color-white);
  }

  .product-card .product-media-container.media-fit img {
    object-fit: contain;
  }

  .product-card .product-badges {
    display: none;
  }

  .product-grid__card .group-block > * {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
    min-width: 0;
    max-width: 100%;
  }

  /* Product card title: allocate exactly 2 lines of space for visual consistency across cards */
  :is(.product-card, .product-grid__card) :is(h4, .h4, [role='heading'], .text-block p) {
    display: -webkit-box !important;
    -webkit-box-orient: vertical !important;
    -webkit-line-clamp: 2 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    overflow-wrap: break-word !important;
    word-break: break-word !important;
    max-width: 100% !important;
    width: 100% !important;
    line-height: 1.3 !important;
    min-height: calc(1.3em * 2) !important;
    height: calc(1.3em * 2) !important;
    text-align: left !important;
  }

  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4, [role='heading'], .text-block p) {
      font-size: var(--font-size--sm, 0.9375rem) !important;
      line-height: 1.25 !important;
      min-height: calc(1.25em * 2) !important;
      height: calc(1.25em * 2) !important;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  .product-card slideshow-arrows .slideshow-control:focus-visible {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:is(:hover, :focus-within) slideshow-arrows .slideshow-control {
      opacity: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
