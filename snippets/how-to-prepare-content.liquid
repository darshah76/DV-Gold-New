{% doc %}
  Renders the shared How to Prepare heading and step list.

  @param {object} product - Product whose preparation metafields are rendered.
  @param {string} heading - Optional section heading.
  @param {number} gap - Heading-to-content gap in pixels.
  @param {string} id - Unique suffix for the heading id.
{% enddoc %}

{% liquid
  assign preparation_steps = product.metafields.custom.how_to_prepare_content.value
  assign preparation_icon_metafield = product.metafields.custom.how_to_prepare_icon
  assign preparation_icons = preparation_icon_metafield.value
  assign desktop_columns = preparation_steps.size | at_most: 5
%}

{% if preparation_steps != blank %}
  <div
    class="how-to-prepare__container{% if heading != blank %} gap-style{% endif %}"
    style="--how-to-prepare-column-count: {{ desktop_columns }};{% if heading != blank %} {% render 'gap-style', value: gap %}{% endif %}"
  >
    {% if heading != blank %}
      <h2 class="how-to-prepare__heading h2" id="HowToPrepareHeading-{{ id }}">
        {{ heading | escape }}
      </h2>
    {% endif %}

    <ol class="how-to-prepare__list">
      {% for step in preparation_steps %}
        {% liquid
          assign step_icon = blank
          assign step_index = forloop.index

          if preparation_icon_metafield.list?
            for preparation_icon in preparation_icons
              if forloop.index == step_index
                assign step_icon = preparation_icon
                break
              endif
            endfor
          else
            assign step_icon = preparation_icons
          endif

          assign step_icon_image = step_icon.preview_image
          if step_icon_image == blank
            assign step_icon_image = step_icon.image.value | default: step_icon.image
          endif
          if step_icon_image == blank and step_icon.width != blank
            assign step_icon_image = step_icon
          endif
          assign step_icon_url = step_icon.url | default: step_icon.src
        %}
        <li class="how-to-prepare__item">
          {% if step_icon != blank %}
            {% if step_icon_image != blank %}
              <div class="how-to-prepare__icon-wrapper">
                {{
                  step_icon_image
                  | image_url: width: 240
                  | image_tag:
                    class: 'how-to-prepare__icon',
                    widths: '80, 120, 160, 240',
                    sizes: '(min-width: 750px) 120px, 96px',
                    loading: 'lazy',
                    alt: ''
                }}
              </div>
            {% elsif step_icon_url != blank %}
              <div class="how-to-prepare__icon-wrapper">
                {% # theme-check-disable RemoteAsset %}
                <img
                  class="how-to-prepare__icon"
                  src="{{ step_icon_url | escape }}"
                  alt=""
                  width="120"
                  height="120"
                  loading="lazy"
                >
                {% # theme-check-enable RemoteAsset %}
              </div>
            {% endif %}
          {% endif %}

          <span class="how-to-prepare__number" aria-hidden="true">{{ forloop.index }}</span>
          <p class="how-to-prepare__text">{{ step | escape | newline_to_br }}</p>
        </li>
      {% endfor %}
    </ol>
  </div>
{% endif %}
