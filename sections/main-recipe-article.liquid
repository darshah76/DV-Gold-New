      assign handle_servings = '2 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Healthy Beverage / Tonic'
      assign handle_diet = 'Vegetarian'
      assign handle_chef_notes = 'Always pair turmeric with a pinch of freshly ground black pepper and healthy fat (ghee or milk) — the piperine in pepper boosts curcumin bioavailability by up to 2000%.'
      assign handle_featured_product_handles = 'turmeric-powder'
      assign handle_ingredients = '[Ingredients]||½ tsp DV Gold Maharashtra Pure Turmeric (Haldi) Powder||2 cups whole milk (or almond / oat milk)||1 pinch freshly ground black pepper (essential for absorption)||1 tsp pure honey or organic jaggery||¼ tsp cinnamon powder or 1 crushed green cardamom||½ tsp pure cow ghee (optional, for maximum nutrient delivery)'
      assign handle_instructions = 'Haldi Doodh (Golden Milk): Bring 2 cups of milk to a gentle simmer in a pot. Whisk in ½ tsp DV Gold Turmeric, a pinch of freshly cracked black pepper, and cardamom. Simmer for 3 minutes. Turn off heat, add honey or jaggery, and sip warm.||Fragrant Turmeric Rice: Stir ½ tsp turmeric into cooking basmati rice with whole spices (clove, bay leaf, ghee) for a vibrant golden restaurant-style pulao.||Golden Dal Tadka: Heat ghee, temper with cumin, garlic, and ½ tsp turmeric, pouring immediately over cooked toor or masoor dal.||Turmeric Wellness Tea: Simmer ¼ tsp turmeric powder, sliced ginger, and lemon in 2 cups of water for 5 minutes. Strain and sweeten with honey.||Golden Vegetable Soup: Blend roasted butternut squash or carrots with vegetable broth, turmeric powder, and fresh ginger for a nourishing golden soup.'
