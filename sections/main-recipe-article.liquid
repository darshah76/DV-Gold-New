      assign handle_featured_product_handles = 'pistachios'
      assign handle_ingredients = '[Ingredients]||1.5 cups DV Gold Shelled Green Pistachios||1 tsp chaat masala||½ tsp Kashmiri red chilli powder||¼ tsp roasted cumin powder||¼ tsp black salt (kala namak)||1 tsp pure cow ghee or fresh lemon juice'
      assign handle_instructions = 'Spiced Masala Pistachios: Heat 1 tsp ghee in a pan on medium-low. Add DV Gold pistachios and roast gently for 3-4 minutes until aromatic. Toss with chaat masala, chilli powder, cumin, and black salt.||Pistachio Greek Yogurt Bowl: Spoon chilled Greek yogurt into a bowl, sprinkle generously with coarsely chopped pistachios, fresh berries, and raw clover honey.||Pistachio Overnight Chia Oats: Mix rolled oats, milk, chia seeds, and chopped pistachios; chill overnight and top with dates in the morning.||No-Bake Pistachio Energy Bites: Blend pitted dates, pistachios, coconut flakes, and a hint of cardamom; shape into green festive energy balls.||Pistachio Herb Pesto: Blend raw pistachios with fresh basil or mint, garlic cloves, extra virgin olive oil, and lemon juice for a rich Mediterranean sauce.||Pistachio-Crusted Paneer: Coat paneer slices with crushed pistachios and herbs, then sear gently on a tawa until golden and crispy.||Pistachio Kesar Smoothie: Blend milk, 1 tbsp soaked pistachios, saffron strands, and cardamom for a royal, refreshing afternoon cooler.'
    when 'black-raisin-recipes', 'recipes/black-raisin-recipes'
      assign handle_prep_time = '10 mins'
      assign handle_cook_time = '5 mins'
      assign handle_total_time = '15 mins'
      assign handle_servings = '4 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Healthy Snack / Breakfast'
      assign handle_diet = 'Vegan / Gluten-Free'
      assign handle_chef_notes = 'Soak black raisins in warm water for 10 minutes before folding into yogurt bowls or chutneys — they plump up double in size, turning extra juicy and soft.'
      assign handle_featured_product_handles = 'black-raisins'
      assign handle_ingredients = '[Ingredients]||1 cup DV Gold Sweet Black Raisins (seedless)||½ cup rolled oats||1.5 cups whole milk or oat milk||½ tsp ground cinnamon||2 tbsp crushed almonds and walnuts||1 tbsp pumpkin seeds||1 tsp raw honey (optional)'
      assign handle_instructions = 'Raisin & Nut Trail Mix: Toss DV Gold Black Raisins with roasted cashews, walnuts, pumpkin seeds, and pistachios for a satisfying midday iron-rich energy bowl.||Cinnamon Raisin Warm Oats: Cook rolled oats in warm milk with black raisins and cinnamon. The plump raisins melt into natural sweetener pockets as the oatmeal thickens.||Raisin Peanut Chikki: Melt jaggery in a pan until hard-crack stage, stir in roasted peanuts and black raisins, pour onto a greased board, and roll flat into chewy brittle.||Sweet Yogurt Parfait: Combine hung curd, plump soaked black raisins, sliced bananas, and a dash of nutmeg for a gut-healthy dessert.||Royal Raisin Pulao: Saute black raisins and cashews in ghee with cumin, cardamom, and bay leaf; fold through cooked basmati rice for festive aroma.||Sweet-Tangy Raisin Chutney: Simmer black raisins with tamarind pulp, grated ginger, cumin, and a pinch of black salt; blend into a glossy dipping chutney for chaats and samosas.'
    when 'walnut-recipes', 'recipes/walnut-recipes'
      assign handle_prep_time = '10 mins'
      assign handle_cook_time = '10 mins'
      assign handle_total_time = '20 mins'
      assign handle_servings = '4 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Gourmet Snack / Salad'
      assign handle_diet = 'Vegetarian / Vegan'
      assign handle_chef_notes = 'Always lightly toast walnut kernels in a dry skillet for 2-3 minutes before tossing into chutneys or salads — toasting removes raw astringency and unlocks intense buttery aroma.'
      assign handle_featured_product_handles = 'walnuts-kernel,walnuts-inshell'
      assign handle_ingredients = '[Ingredients]||1.5 cups DV Gold Walnut Kernels||½ tsp Kashmiri chilli powder||½ tsp freshly cracked black pepper||½ tsp roasted cumin powder||1 tbsp pure maple syrup or raw honey||1 tsp olive oil or melted ghee||Flaky sea salt to taste'
      assign handle_instructions = 'Spiced Maple-Glazed Walnuts: Heat olive oil and maple syrup in a skillet. Add DV Gold walnut halves and coat evenly on medium heat for 3-4 minutes. Dust with chilli powder, cumin, and flaky salt; spread on parchment paper to cool.||Walnut & Banana Gourmet Toast: Toast hearty sourdough bread, spread generously with almond butter, top with sliced banana, crushed walnuts, and a drizzle of honey.||Creamy Walnut Yogurt Bowl: Top cold Greek yogurt with toasted walnuts, fresh pomegranate seeds, and a pinch of cinnamon.||Green Walnut Chutney: Blend walnuts with fresh coriander, green chillies, garlic, lemon juice, and salt for a velvety rich green chutney.||Walnut Basil Pesto: Substitute walnuts in classic pesto with fresh basil leaves, garlic, olive oil, and parmesan — walnuts add an earthy, rich buttery body.||Crisp Apple & Walnut Salad: Toss crisp sliced apples, toasted walnuts, salad greens, and crumbled paneer/feta in a light honey-mustard vinaigrette.'
    when 'cashew-nut-recipes', 'recipes/cashew-nut-recipes'
      assign handle_prep_time = '5 mins'
      assign handle_cook_time = '10 mins'
      assign handle_total_time = '15 mins'
      assign handle_servings = '4 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Snack / Party Appetizer'
      assign handle_diet = 'Vegetarian / Gluten-Free'
      assign handle_chef_notes = 'Always roast cashews on a low flame! Cashews have a high natural sugar content and burn rapidly on high heat. Roasting on low heat ensures the cashew stays buttery and creamy inside while crisped outside.'
      assign handle_featured_product_handles = 'cashew-nuts'
      assign handle_ingredients = '[Ingredients]||1.5 cups DV Gold Whole Premium Cashew Nuts||1 tbsp pure desi ghee||½ tsp freshly ground black pepper||½ tsp Kashmiri red chilli powder||½ tsp roasted cumin powder||½ tsp chaat masala||Rock salt (sendha namak) to taste'
      assign handle_instructions = 'Desi Ghee Masala Roasted Cashews: Heat 1 tbsp pure cow ghee in a heavy pan. Add whole DV Gold Cashews and roast on low flame, stirring continuously for 5–7 minutes until golden and crisp. Immediately toss with black pepper, chilli, cumin, chaat masala, and rock salt.||Honey-Cinnamon Glazed Cashews: Roast cashews lightly in butter, drizzle with warm honey, and sprinkle ground cinnamon and sea salt for a sweet-savory party snack.||Tangy Cashew Chaat: Toss roasted cashews with finely diced onions, tomatoes, green chillies, fresh coriander, lemon juice, and crunchy sev.||Cashew Date Energy Bites: Pulse cashews with pitted dates and desiccated coconut; shape into bite-sized balls for convenient grab-and-go fuel.||Royal Shahi Cashew Curry Paste: Soak ½ cup cashews in hot water for 15 minutes, then blend with a little water into an ultra-smooth velvety paste to enrich shahi paneer and vegetable curries.||Crunchy Cashew Granola: Toss whole and chopped cashews with rolled oats, pumpkin seeds, honey, and vanilla; bake until golden and crunchy.'
  endcase

  # Metafield lookups (take precedence if defined in Shopify Admin)
  assign prep_time = recipe.metafields.custom.prep_time.value | default: recipe.metafields.custom.prep_time | default: handle_prep_time
  assign cook_time = recipe.metafields.custom.cook_time.value | default: recipe.metafields.custom.cook_time | default: handle_cook_time
  assign total_time = recipe.metafields.custom.total_time.value | default: recipe.metafields.custom.total_time | default: handle_total_time
  assign servings = recipe.metafields.custom.servings.value | default: recipe.metafields.custom.servings | default: handle_servings
  assign difficulty = recipe.metafields.custom.difficulty.value | default: recipe.metafields.custom.difficulty | default: handle_difficulty
  assign course = recipe.metafields.custom.course.value | default: recipe.metafields.custom.course | default: handle_course
  assign diet = recipe.metafields.custom.diet.value | default: recipe.metafields.custom.diet | default: handle_diet
  assign chef_notes = recipe.metafields.custom.chef_notes.value | default: recipe.metafields.custom.chef_notes | default: handle_chef_notes

  # Cooked dish gallery metafield (only render if actual images are assigned)
  assign cooked_dish_gallery = recipe.metafields.custom.cooked_dish_images.value | default: recipe.metafields.custom.recipe_gallery.value

  # Ingredients metafield
  assign ingredients_meta = recipe.metafields.custom.ingredients.value | default: recipe.metafields.custom.ingredients

  # Instructions metafield
  assign instructions_meta = recipe.metafields.custom.instructions.value | default: recipe.metafields.custom.instructions | default: recipe.metafields.custom.method.value

  # Featured products metafield
  assign featured_products = recipe.metafields.custom.featured_products.value | default: recipe.metafields.custom.products.value
%}

<div class="section-background"></div>

<article
  class="section section--page-width recipe-article spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  id="RecipeArticle-{{ section.id }}"
>
  <div class="recipe-article__container">
    {% # Header & Navigation %}
    <nav class="recipe-article__nav" aria-label="Recipe Navigation">
      <a class="recipe-article__back" href="{{ current_blog.url | default: '/blogs/recipes' }}">
        <svg class="recipe-article__back-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ section.settings.back_label | default: 'Back to Recipes' }}</span>
      </a>
      {% if course != blank or diet != blank %}
        <div class="recipe-article__tags">
          {% if course != blank %}
            <span class="recipe-article__tag">{{ course | escape }}</span>
          {% endif %}
          {% if diet != blank %}
            <span class="recipe-article__tag recipe-article__tag--diet">{{ diet | escape }}</span>
          {% endif %}
        </div>
      {% endif %}
    </nav>

    {% # Recipe Title & Description %}
    <header class="recipe-article__header">
      <h1 class="recipe-article__title">{{ recipe.title | escape }}</h1>

      {% if recipe.excerpt != blank %}
        <p class="recipe-article__excerpt">{{ recipe.excerpt | strip_html }}</p>
      {% endif %}

      <div class="recipe-article__byline">
        {% if section.settings.show_date and recipe.published_at != blank %}
          <span class="recipe-article__date">
            {{ recipe.published_at | time_tag: format: 'date' }}
          </span>
        {% endif %}
        {% if section.settings.show_author and recipe.author != blank %}
          <span class="recipe-article__author">By {{ recipe.author | escape }}</span>
        {% endif %}
      </div>
    </header>

    {% # Recipe Quick Facts Badges Bar %}
    {% if prep_time != blank or cook_time != blank or servings != blank or difficulty != blank %}
      <div class="recipe-article__meta-bar" aria-label="Recipe quick facts">
        <div class="recipe-article__meta-grid">
          {% if prep_time != blank %}
            <div class="recipe-article__meta-item">
              <span class="recipe-article__meta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
              </span>
              <div class="recipe-article__meta-content">
                <span class="recipe-article__meta-label">Prep Time</span>
                <span class="recipe-article__meta-value">{{ prep_time | escape }}</span>
              </div>
            </div>
          {% endif %}

          {% if cook_time != blank %}
            <div class="recipe-article__meta-item">
              <span class="recipe-article__meta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                </svg>
              </span>
              <div class="recipe-article__meta-content">
                <span class="recipe-article__meta-label">Cook Time</span>
                <span class="recipe-article__meta-value">{{ cook_time | escape }}</span>
              </div>
            </div>
          {% endif %}

          {% if servings != blank %}
            <div class="recipe-article__meta-item">
              <span class="recipe-article__meta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/>
                </svg>
              </span>
              <div class="recipe-article__meta-content">
                <span class="recipe-article__meta-label">Servings</span>
                <span class="recipe-article__meta-value">{{ servings | escape }}</span>
              </div>
            </div>
          {% endif %}

          {% if difficulty != blank %}
            <div class="recipe-article__meta-item">
              <span class="recipe-article__meta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/>
                </svg>
              </span>
              <div class="recipe-article__meta-content">
                <span class="recipe-article__meta-label">Difficulty</span>
                <span class="recipe-article__meta-value">{{ difficulty | escape }}</span>
              </div>
            </div>
          {% endif %}
        </div>

        {% # Quick Actions: Jump to Recipe & Click to Print %}
        <div class="recipe-article__actions">
          <a class="recipe-article__action-btn recipe-article__action-btn--jump" href="#RecipeMethod-{{ section.id }}">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 4V16M10 16L5 11M10 16L15 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Jump to Recipe</span>
          </a>
          <button
            type="button"
            class="recipe-article__action-btn recipe-article__action-btn--print"
            onclick="window.print()"
            aria-label="Print this recipe"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
            </svg>
            <span>Print Recipe</span>
          </button>
        </div>
      </div>
    {% endif %}

    {% # Recipe Banner Image (only if image uploaded on article) %}
    {% if recipe.image != blank %}
      <div class="recipe-article__banner-wrapper">
        {{
          recipe.image
          | image_url: width: 1600
          | image_tag:
            class: 'recipe-article__banner',
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 1440px) 1360px, (min-width: 750px) calc(100vw - 80px), calc(100vw - 32px)',
            loading: 'eager',
            alt: recipe.image.alt | default: recipe.title
        }}
      </div>
    {% endif %}

    {% # Cooked Dish Gallery (only if actual images are assigned) %}
    {% if cooked_dish_gallery != blank and cooked_dish_gallery.size > 0 %}
      <div class="recipe-article__gallery" aria-label="Cooked Dish Gallery">
        <div class="recipe-article__gallery-header">
          <h2 class="recipe-article__gallery-title">Gallery of the Cooked Dish</h2>
          <span class="recipe-article__gallery-count">{{ cooked_dish_gallery.size }} photos</span>
        </div>
        <div class="recipe-article__gallery-grid">
          {% for img in cooked_dish_gallery %}
            {% liquid
              assign gallery_img = img.preview_image | default: img
              assign gallery_alt = img.alt | default: recipe.title | append: ' - Dish view ' | append: forloop.index
            %}
            <figure class="recipe-article__gallery-item">
              {{
                gallery_img
                | image_url: width: 800
                | image_tag:
                  class: 'recipe-article__gallery-img',
                  widths: '240, 360, 480, 640, 800',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                  loading: 'lazy',
                  alt: gallery_alt
              }}
            </figure>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% # Main Recipe Content: Split 2-Column Grid %}
    <div class="recipe-article__body" id="RecipeMethod-{{ section.id }}">
      {% # Left Column: Ingredients Checklist %}
      <aside class="recipe-article__ingredients-card" aria-label="Ingredients">
        <div class="recipe-article__card-header">
          <div class="recipe-article__card-heading-group">
            <h2 class="recipe-article__card-title">Ingredients</h2>
            {% if servings != blank %}
              <span class="recipe-article__servings-badge">For {{ servings | escape }}</span>
            {% endif %}
          </div>
          <span class="recipe-article__checklist-tip" aria-hidden="true">Click items to check off</span>
        </div>

        <ul class="recipe-article__ingredients-list" role="list">
          {% if ingredients_meta != blank %}
            {% if ingredients_meta.list? %}
              {% for item in ingredients_meta %}
                <li class="recipe-article__ingredient-item">
                  <label class="recipe-article__ingredient-label">
                    <input type="checkbox" class="recipe-article__checkbox">
                    <span class="recipe-article__checkbox-custom" aria-hidden="true"></span>
                    <span class="recipe-article__ingredient-text">{{ item | escape }}</span>
                  </label>
                </li>
              {% endfor %}
            {% else %}
              {% assign ingredient_lines = ingredients_meta | newline_to_br | split: '<br />' %}
              {% for line in ingredient_lines %}
                {% assign cleaned_line = line | strip %}
                {% if cleaned_line != blank %}
                  {% if cleaned_line contains '---' or cleaned_line contains '[' %}
                    <li class="recipe-article__ingredient-subheading">
                      <strong>{{ cleaned_line | remove: '---' | remove: '[' | remove: ']' | strip }}</strong>
                    </li>
                  {% else %}
                    <li class="recipe-article__ingredient-item">
                      <label class="recipe-article__ingredient-label">
                        <input type="checkbox" class="recipe-article__checkbox">
                        <span class="recipe-article__checkbox-custom" aria-hidden="true"></span>
                        <span class="recipe-article__ingredient-text">{{ cleaned_line | escape }}</span>
                      </label>
                    </li>
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endif %}
          {% elsif handle_ingredients != blank %}
            {% assign ing_items = handle_ingredients | split: '||' %}
            {% for item in ing_items %}
              {% assign cleaned_item = item | strip %}
              {% if cleaned_item != blank %}
                {% if cleaned_item contains '[' and cleaned_item contains ']' %}
                  <li class="recipe-article__ingredient-subheading">
                    <strong>{{ cleaned_item | remove: '[' | remove: ']' | strip }}</strong>
                  </li>
                {% else %}
                  <li class="recipe-article__ingredient-item">
                    <label class="recipe-article__ingredient-label">
                      <input type="checkbox" class="recipe-article__checkbox">
                      <span class="recipe-article__checkbox-custom" aria-hidden="true"></span>
                      <span class="recipe-article__ingredient-text">{{ cleaned_item | escape }}</span>
                    </label>
                  </li>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% else %}
            <li class="recipe-article__ingredient-item">
              <label class="recipe-article__ingredient-label">
                <input type="checkbox" class="recipe-article__checkbox">
                <span class="recipe-article__checkbox-custom" aria-hidden="true"></span>
                <span class="recipe-article__ingredient-text">Fresh ingredients per recipe instructions below</span>
              </label>
            </li>
          {% endif %}
        </ul>
      </aside>

      {% # Right Column: Step-by-Step Method / Instructions %}
      <section class="recipe-article__method-card" aria-label="Preparation Method">
        <h2 class="recipe-article__card-title">Preparation Method</h2>

        <div class="recipe-article__method-steps">
          {% if instructions_meta != blank %}
            {% if instructions_meta.list? %}
              <ol class="recipe-article__steps-list">
                {% for step in instructions_meta %}
                  <li class="recipe-article__step-item">
                    <span class="recipe-article__step-number" aria-hidden="true">{{ forloop.index }}</span>
                    <div class="recipe-article__step-text">
                      <p>{{ step | escape | newline_to_br }}</p>
                    </div>
                  </li>
                {% endfor %}
              </ol>
            {% else %}
              {% assign step_lines = instructions_meta | newline_to_br | split: '<br />' %}
              <ol class="recipe-article__steps-list">
                {% assign step_idx = 0 %}
                {% for line in step_lines %}
                  {% assign cleaned_step = line | strip %}
                  {% if cleaned_step != blank %}
                    {% assign step_idx = step_idx | plus: 1 %}
                    <li class="recipe-article__step-item">
                      <span class="recipe-article__step-number" aria-hidden="true">{{ step_idx }}</span>
                      <div class="recipe-article__step-text">
                        <p>{{ cleaned_step | escape }}</p>
                      </div>
                    </li>
                  {% endif %}
                {% endfor %}
              </ol>
            {% endif %}
          {% elsif handle_instructions != blank %}
            <ol class="recipe-article__steps-list">
              {% assign step_items = handle_instructions | split: '||' %}
              {% for step in step_items %}
                {% assign cleaned_step = step | strip %}
                {% if cleaned_step != blank %}
                  <li class="recipe-article__step-item">
                    <span class="recipe-article__step-number" aria-hidden="true">{{ forloop.index }}</span>
                    <div class="recipe-article__step-text">
                      <p>{{ cleaned_step | escape }}</p>
                    </div>
                  </li>
                {% endif %}
              {% endfor %}
            </ol>
          {% else %}
            {% # Render standard article content with styled numbered steps %}
            <div class="recipe-article__content-rte rte">
              {{ recipe.content }}
            </div>
          {% endif %}
        </div>

        {% # Chef's Tips & Notes Box %}
        {% if chef_notes != blank %}
          <div class="recipe-article__chef-notes">
            <div class="recipe-article__notes-header">
              <svg class="recipe-article__notes-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
              </svg>
              <h3 class="recipe-article__notes-title">Chef's Secret Tips</h3>
            </div>
            <div class="recipe-article__notes-body">
              <p>{{ chef_notes | escape | newline_to_br }}</p>
            </div>
          </div>
        {% endif %}
      </section>
    </div>

    {% # Featured Products: Shop Genuine DV Gold Ingredients %}
    {% liquid
      # Products selected from metafield product list type: custom.featured_products
      assign recipe_products = recipe.metafields.custom.featured_products.value | default: recipe.metafields.custom.recipe_products.value

      # Fallback to handle defaults if metafield not yet populated
      assign fallback_handles = ''
      if recipe_products == blank or recipe_products.size == 0
        if handle_featured_product_handles != blank
          assign fallback_handles = handle_featured_product_handles | split: ','
        endif
      endif
    %}

    {% if recipe_products != blank or fallback_handles != blank %}
      <section class="recipe-article__products" aria-label="Shop Genuine DV Gold Ingredients">
        <header class="recipe-article__products-header">
          <h2 class="recipe-article__products-title">{{ section.settings.products_heading | default: 'Shop Genuine DV Gold Ingredients' }}</h2>
          <p class="recipe-article__products-subtitle">Get the authentic taste with pure, preservative-free DV Gold products.</p>
        </header>

        <ul class="recipe-article__products-grid" role="list">
          {% if recipe_products != blank and recipe_products.size > 0 %}
            {% for prod in recipe_products limit: 5 %}
              {% capture card_children %}
                <div
                  ref="cardGallery"
                  class="card-gallery spacing-style border-style card-gallery--badge-top-right"
                  style="--gallery-aspect-ratio: 1;"
                  data-product-id="{{ prod.id }}"
                  data-image-ratio="adapt"
                >
                  <a
                    class="contents"
                    ref="cardGalleryLink"
                    href="{{ prod.url }}"
                    aria-label="{{ prod.title | escape }}"
                  >
                    <div
                      class="product-media-container media-fit product-media-container--image"
                      style="--product-media-fit: cover;"
                    >
                      <div class="product-media" style="--ratio: 1">
                        {% if prod.featured_media %}
                          {{
                            prod.featured_media.preview_image
                            | image_url: width: 800
                            | image_tag:
                              class: 'product-media__image',
                              widths: '240, 352, 500, 800',
                              sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 50vw',
                              loading: 'lazy',
                              alt: prod.title
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %}
                      </div>
                    </div>
                  </a>

                  {% if prod.available == false %}
                    <div
                      class="product-badges product-badges--top-right"
                      style="--badge-border-radius: 100px; --badge-font-family: var(--font-body--family); --badge-font-weight: var(--font-body--weight); --badge-text-transform: none;"
                    >
                      <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-sold-out">
                        {{ 'content.product_badge_sold_out' | t | default: 'Sold out' }}
                      </div>
                    </div>
                  {% elsif prod.compare_at_price > prod.price %}
                    <div
                      class="product-badges product-badges--top-right"
                      style="--badge-border-radius: 100px; --badge-font-family: var(--font-body--family); --badge-font-weight: var(--font-body--weight); --badge-text-transform: none;"
                    >
                      <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-sale">
                        {{ 'content.product_badge_sale' | t | default: 'Sale' }}
                      </div>
                    </div>
                  {% endif %}
                </div>

                <div class="product-grid-view-zoom-out--details">
                  <h3 class="h4">{{ prod.title | escape }}</h3>
                </div>

                <a
                  class="contents user-select-text"
                  ref="productTitleLink"
                  href="{{ prod.url }}"
                >
                  <div
                    class="spacing-style text-block paragraph text-block--align-left rte"
                    style="margin-inline: var(--padding-lg); --padding-block-start: 4px; --padding-block-end: 0px; --padding-inline-start: 0px; --padding-inline-end: 0px; --width: 100%; --max-width: var(--max-width--body-normal); --text-align: left;"
                  >
                    <p role="heading" aria-level="3" style="font-family: var(--font-body--family); font-weight: 600; font-size: var(--font-size--base); color: var(--color-foreground); margin: 0; line-height: 1.3;">
                      {{ prod.title | escape }}
                    </p>
                  </div>
                </a>

                <product-price
                  class="text-block text-block--align-left text-left h6 spacing-style"
                  data-product-id="{{ prod.id }}"
                  style="--padding-block-start: 0px; --padding-block-end: 0px; --padding-inline-start: 0px; --padding-inline-end: 0px; --width: 100%;"
                >
                  {% render 'price', product_resource: prod, show_sale_price_first: true %}
                </product-price>
              {% endcapture %}

              <li class="product-grid__item" data-product-id="{{ prod.id }}">
                {% render 'product-card',
                  product: prod,
                  children: card_children,
                  product_card_gap: 4,
                  product_view_context: 'collection'
                %}
              </li>
            {% endfor %}
          {% elsif fallback_handles != blank %}
            {% for prod_handle in fallback_handles limit: 5 %}
              {% assign prod = all_products[prod_handle] %}
              {% if prod != blank and prod.title != blank %}
                {% capture card_children %}
                  <div
                    ref="cardGallery"
                    class="card-gallery spacing-style border-style card-gallery--badge-top-right"
                    style="--gallery-aspect-ratio: 1;"
                    data-product-id="{{ prod.id }}"
                    data-image-ratio="adapt"
                  >
                    <a
                      class="contents"
                      ref="cardGalleryLink"
                      href="{{ prod.url }}"
                      aria-label="{{ prod.title | escape }}"
                    >
                      <div
                        class="product-media-container media-fit product-media-container--image"
                        style="--product-media-fit: cover;"
                      >
                        <div class="product-media" style="--ratio: 1">
                          {% if prod.featured_media %}
                            {{
                              prod.featured_media.preview_image
                              | image_url: width: 800
                              | image_tag:
                                class: 'product-media__image',
                                widths: '240, 352, 500, 800',
                                sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 50vw',
                                loading: 'lazy',
                                alt: prod.title
                            }}
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}
                        </div>
                      </div>
                    </a>

                    {% if prod.available == false %}
                      <div
                        class="product-badges product-badges--top-right"
                        style="--badge-border-radius: 100px; --badge-font-family: var(--font-body--family); --badge-font-weight: var(--font-body--weight); --badge-text-transform: none;"
                      >
                        <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-sold-out">
                          {{ 'content.product_badge_sold_out' | t | default: 'Sold out' }}
                        </div>
                      </div>
                    {% elsif prod.compare_at_price > prod.price %}
                      <div
                        class="product-badges product-badges--top-right"
                        style="--badge-border-radius: 100px; --badge-font-family: var(--font-body--family); --badge-font-weight: var(--font-body--weight); --badge-text-transform: none;"
                      >
                        <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-sale">
                          {{ 'content.product_badge_sale' | t | default: 'Sale' }}
                        </div>
                      </div>
                    {% endif %}
                  </div>

                  <div class="product-grid-view-zoom-out--details">
                    <h3 class="h4">{{ prod.title | escape }}</h3>
                  </div>

                  <a
                    class="contents user-select-text"
                    ref="productTitleLink"
                    href="{{ prod.url }}"
                  >
                    <div
                      class="spacing-style text-block paragraph text-block--align-left rte"
                      style="margin-inline: var(--padding-lg); --padding-block-start: 4px; --padding-block-end: 0px; --padding-inline-start: 0px; --padding-inline-end: 0px; --width: 100%; --max-width: var(--max-width--body-normal); --text-align: left;"
                    >
                      <p role="heading" aria-level="3" style="font-family: var(--font-body--family); font-weight: 600; font-size: var(--font-size--base); color: var(--color-foreground); margin: 0; line-height: 1.3;">
                        {{ prod.title | escape }}
                      </p>
                    </div>
                  </a>

                  <product-price
                    class="text-block text-block--align-left text-left h6 spacing-style"
                    data-product-id="{{ prod.id }}"
                    style="--padding-block-start: 0px; --padding-block-end: 0px; --padding-inline-start: 0px; --padding-inline-end: 0px; --width: 100%;"
                  >
                    {% render 'price', product_resource: prod, show_sale_price_first: true %}
                  </product-price>
                {% endcapture %}

                <li class="product-grid__item" data-product-id="{{ prod.id }}">
                  {% render 'product-card',
                    product: prod,
                    children: card_children,
                    product_card_gap: 4,
                    product_view_context: 'collection'
                  %}
                </li>
              {% endif %}
            {% endfor %}
          {% endif %}
        </ul>

        {% render 'product-card-styles' %}
        {% render 'quantity-selector-styles' %}
        {% render 'buy-buttons-styles' %}
        {% render 'gift-card-recipient-form-styles' %}
        {% render 'quick-add-styles' %}
        {% render 'quick-add-modal-styles' %}
        {% render 'swatch-styles' %}
        {% render 'variant-picker-styles' %}
        {% render 'product-badges-styles' %}
        {% render 'price-styles' %}
        {% render 'product-card-gallery-zoom-details-styles' %}
      </section>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .recipe-article {
    width: 100%;
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  .recipe-article__container {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: var(--narrow-page-width);
    margin: 0 auto;
    gap: 32px;
  }

  /* Navigation */
  .recipe-article__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
  }

  .recipe-article__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: var(--font-size--sm);
    text-decoration: none;
    transition: color 0.15s ease-in-out;
  }

  .recipe-article__back:hover {
    color: var(--color-heading);
  }

  .recipe-article__back-icon {
    width: 18px;
    height: 18px;
  }

  .recipe-article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .recipe-article__tag {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: var(--font-size--xs);
    color: var(--color-foreground);
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: 40px;
    letter-spacing: 0.02em;
  }

  .recipe-article__tag--diet {
    color: #1b5e20;
    background: #e8f5e9;
    border-color: rgba(27, 94, 32, 0.2);
  }

  /* Header */
  .recipe-article__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
    max-width: 52rem;
    margin: 0 auto;
  }

  .recipe-article__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    color: var(--color-heading);
    text-wrap: balance;
  }

  .recipe-article__excerpt {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: var(--font-size--lg);
    line-height: var(--font-paragraph--line-height);
    color: var(--color-foreground);
    text-wrap: pretty;
  }

  .recipe-article__byline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  /* Quick Facts Meta Bar */
  .recipe-article__meta-bar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-lg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }

  @media (min-width: 990px) {
    .recipe-article__meta-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 20px 32px;
    }
  }

  .recipe-article__meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    flex: 1;
  }

  @media (min-width: 750px) {
    .recipe-article__meta-grid {
      grid-template-columns: repeat(4, auto);
      gap: 32px;
    }
  }

  .recipe-article__meta-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .recipe-article__meta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-heading);
    background: var(--color-background);
    border-radius: var(--style-border-radius-50);
    flex-shrink: 0;
  }

  .recipe-article__meta-icon svg {
    width: 22px;
    height: 22px;
  }

  .recipe-article__meta-content {
    display: flex;
    flex-direction: column;
  }

  .recipe-article__meta-label {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .recipe-article__meta-value {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    font-weight: 700;
    color: var(--color-foreground);
  }

  /* Actions (Jump & Print) */
  .recipe-article__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .recipe-article__action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: var(--font-size--sm);
    text-decoration: none;
    border-radius: var(--style-border-radius-buttons-primary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .recipe-article__action-btn svg {
    width: 18px;
    height: 18px;
  }

  .recipe-article__action-btn--jump {
    color: var(--color-foreground);
    background: var(--color-background);
    border: var(--style-border-width) solid var(--color-card-border-warm);
  }

  .recipe-article__action-btn--jump:hover {
    background: #f4edd4;
    color: var(--color-foreground);
  }

  .recipe-article__action-btn--print {
    color: var(--color-white);
    background: var(--color-heading);
    border: var(--style-border-width) solid var(--color-heading);
  }

  .recipe-article__action-btn--print:hover {
    background: #ba8f4e;
    border-color: #ba8f4e;
  }

  /* Hero Banner */
  .recipe-article__banner-wrapper {
    width: 100%;
    border-radius: var(--style-border-radius-lg);
    overflow: hidden;
    border: var(--style-border-width) solid var(--color-card-border-warm);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  .recipe-article__banner {
    display: block;
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    background: var(--color-background-secondary);
  }

  /* Gallery */
  .recipe-article__gallery {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-lg);
  }

  .recipe-article__gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .recipe-article__gallery-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--font-size--lg);
    color: var(--color-heading);
    font-weight: 400;
  }

  .recipe-article__gallery-count {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .recipe-article__gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (min-width: 750px) {
    .recipe-article__gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }

  .recipe-article__gallery-item {
    margin: 0;
    border-radius: var(--style-border-radius-sm);
    overflow: hidden;
    border: var(--style-border-width) solid var(--color-card-border-warm);
    background: var(--color-background);
  }

  .recipe-article__gallery-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .recipe-article__gallery-img:hover {
    transform: scale(1.03);
  }

  /* Split Layout */
  .recipe-article__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (min-width: 990px) {
    .recipe-article__body {
      grid-template-columns: 340px 1fr;
      gap: 40px;
    }
  }

  /* Left Column: Ingredients Card */
  .recipe-article__ingredients-card {
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-lg);
    padding: 28px 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  @media (min-width: 990px) {
    .recipe-article__ingredients-card {
      position: sticky;
      top: calc(var(--header-height, 90px) + 24px);
    }
  }

  .recipe-article__card-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 18px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--color-card-border-warm);
  }

  .recipe-article__card-heading-group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .recipe-article__card-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--font-size--xl);
    color: var(--color-heading);
  }

  .recipe-article__servings-badge {
    display: inline-block;
    padding: 4px 10px;
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    font-weight: 600;
    color: var(--color-heading);
    background: var(--color-background);
    border-radius: 20px;
    white-space: nowrap;
  }

  .recipe-article__checklist-tip {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-style: italic;
  }

  .recipe-article__ingredients-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .recipe-article__ingredient-subheading {
    padding-top: 10px;
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: var(--font-size--sm);
    color: var(--color-heading);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .recipe-article__ingredient-item {
    display: flex;
    align-items: flex-start;
  }

  .recipe-article__ingredient-label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    cursor: pointer;
    user-select: none;
  }

  .recipe-article__checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .recipe-article__checkbox-custom {
    position: relative;
    top: 2px;
    width: 18px;
    height: 18px;
    border: 1.5px solid #a8a49c;
    border-radius: 4px;
    background: var(--color-white);
    flex-shrink: 0;
    transition: all 0.15s ease-in-out;
  }

  .recipe-article__checkbox:checked + .recipe-article__checkbox-custom {
    background: var(--color-heading);
    border-color: var(--color-heading);
  }

  .recipe-article__checkbox:checked + .recipe-article__checkbox-custom::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .recipe-article__ingredient-text {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    line-height: 1.45;
    color: var(--color-foreground);
    transition: all 0.15s ease-in-out;
  }

  .recipe-article__checkbox:checked ~ .recipe-article__ingredient-text {
    text-decoration: line-through;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  /* Right Column: Method Card */
  .recipe-article__method-card {
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-lg);
    padding: 32px 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  @media (min-width: 750px) {
    .recipe-article__method-card {
      padding: 40px 36px;
    }
  }

  .recipe-article__steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .recipe-article__step-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .recipe-article__step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-heading);
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--font-size--md);
    flex-shrink: 0;
    border: 1px solid var(--color-card-border-warm);
  }

  .recipe-article__step-text {
    flex: 1;
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: var(--font-paragraph--line-height);
    color: var(--color-foreground);
  }

  .recipe-article__step-text p {
    margin: 0;
  }

  .recipe-article__content-rte {
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    line-height: var(--font-paragraph--line-height);
    color: var(--color-foreground);
  }

  .recipe-article__content-rte h2,
  .recipe-article__content-rte h3 {
    font-family: var(--font-heading--family);
    color: var(--color-heading);
    font-weight: 400;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  /* Chef's Secret Tips Box */
  .recipe-article__chef-notes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--color-background);
    border-left: 4px solid var(--color-heading);
    border-radius: 0 var(--style-border-radius-md) var(--style-border-radius-md) 0;
    padding: 20px 24px;
    margin-top: 8px;
  }

  .recipe-article__notes-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .recipe-article__notes-icon {
    width: 20px;
    height: 20px;
    color: var(--color-heading);
    flex-shrink: 0;
  }

  .recipe-article__notes-title {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: var(--font-size--sm);
    color: var(--color-heading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .recipe-article__notes-body p {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    line-height: 1.6;
    color: var(--color-foreground);
  }

  /* Featured Products Section */
  .recipe-article__products {
    margin-top: 24px;
    padding-top: 40px;
    border-top: 1px solid rgba(207, 165, 100, 0.25);
    display: flex;
    flex-direction: column;
    gap: 28px;
    scroll-margin-top: 80px;
  }

  .recipe-article__products-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .recipe-article__products-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-heading);
    font-weight: 400;
  }

  .recipe-article__products-subtitle {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--base);
    color: var(--color-foreground);
    opacity: 0.85;
  }

  .recipe-article__products-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  @media (min-width: 750px) {
    .recipe-article__products-grid {
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 20px;
    }
  }

  @media (min-width: 990px) {
    .recipe-article__products-grid {
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 24px;
    }
  }

  @media (min-width: 1200px) {
    .recipe-article__products-grid {
      grid-template-columns: repeat(5, 1fr) !important;
      gap: 24px;
    }
  }

  .recipe-article__products-grid .product-grid__item {
    display: flex;
    flex-direction: column;
    list-style: none;
  }

  .recipe-article__products-grid product-card {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .recipe-article__products-grid .product-card__content {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--color-white, #ffffff);
    border: 1px solid rgba(207, 165, 100, 0.25);
    border-radius: var(--style-border-radius-lg, 16px);
    padding: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .recipe-article__products-grid .product-card__content > .quick-add {
    margin-top: auto;
    padding-top: 12px;
  }

  .recipe-article__products-grid .product-card__content:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
  }

  /* Print Stylesheet */
  @media print {
    header, footer, nav, .header, .footer,
    .recipe-article__nav,
    .recipe-article__actions,
    .recipe-article__checklist-tip,
    .recipe-article__products,
    .section-background {
      display: none !important;
    }

    body, .recipe-article {
      background: #ffffff !important;
      color: #000000 !important;
    }

    .recipe-article__container {
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      gap: 16px !important;
    }

    .recipe-article__body {
      display: block !important;
    }

    .recipe-article__ingredients-card,
    .recipe-article__method-card,
    .recipe-article__meta-bar {
      border: 1px solid #cccccc !important;
      box-shadow: none !important;
      position: static !important;
      margin-bottom: 20px !important;
      page-break-inside: avoid;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main Recipe Article",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label",
      "default": "Back to Recipes"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show published date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author name",
      "default": false
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Featured Products Heading",
      "default": "Shop Genuine DV Gold Ingredients"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ]
}
{% endschema %}
