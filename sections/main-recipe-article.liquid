{% doc %}
  Main Recipe Article section for DV Foods storefront.
  Provides a recipe layout with banner image, cooked dish gallery,
  interactive ingredients checklist, numbered step-by-step instructions,
  recipe metadata badges, click-to-print functionality, and featured products.
{% enddoc %}

{% liquid
  assign recipe = article
  assign current_blog = blog | default: article.blog

  # Default data lookup by handle
  assign handle_prep_time = ''
  assign handle_cook_time = ''
  assign handle_total_time = ''
  assign handle_servings = ''
  assign handle_difficulty = ''
  assign handle_course = ''
  assign handle_diet = ''
  assign handle_chef_notes = ''
  assign handle_featured_product_handles = ''
  assign handle_ingredients = ''
  assign handle_instructions = ''

  assign raw_handle = recipe.handle | default: ''
  assign clean_handle = raw_handle | split: '/' | last

  case clean_handle
    when 'chai-recipes', 'recipes/chai-recipes'
      assign handle_prep_time = '5 mins'
      assign handle_cook_time = '10 mins'
      assign handle_total_time = '15 mins'
      assign handle_servings = '4 cups'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Hot Beverage'
      assign handle_diet = 'Vegetarian'
      assign handle_chef_notes = 'Always add tea leaves to rolling boiling water, never to cold water. For black-tea blends, never boil tea leaves directly in milk — add milk only after the tea essence has fully infused in water.'
      assign handle_featured_product_handles = 'dv-gold-tea,dv-silver-tea,dv-klassik-tea'
      assign handle_ingredients = '[For the Kadak Brew]||2 cups fresh filtered water||1.5 tbsp DV Gold Premium CTC Tea||1 cup whole fresh milk||2 tsp raw sugar (or to taste)||[Aromatics & Spices]||½ tsp fresh grated ginger (adrak)||2 green cardamom pods (crushed)||1 small pinch DV Chai Masala (optional)'
      assign handle_instructions = 'Kadak Masala Chai: Bring 2 cups of fresh water to a rolling boil in a saucepan. Add 1.5 tbsp DV Gold Tea and crushed spices (ginger, cardamom, or chai masala). Simmer on medium flame for 3 minutes until rich and fragrant.||Add Milk & Re-Boil: Pour in 1 cup whole milk and sugar to taste. Bring the brew to a full foaming boil, then reduce heat and let it bubble twice so the milk enriches the brisk Assam-Bengal CTC tea.||Adrak Chai Variation: For an immunity-boosting ginger brew, simmer 1 tsp freshly grated ginger with DV Gold or Silver Tea before adding milk.||Elaichi Chai Variation: Crush 2 cardamom pods into boiling water before adding tea leaves — gentler, floral, and ideal with DV Klassik.||Doodh Patti (Milk-First): Simmer tea leaves directly in 2 cups of milk on low heat — DV Klassik’s rich character shines best here.||Black Chai (No Milk): Brew DV Gold or Silver briskly in boiling water for 3 minutes, strain into cups, and finish with a squeeze of fresh lemon.'
    when 'shinghoda-flour-recipes', 'recipes/shinghoda-flour-recipes'
      assign handle_prep_time = '15 mins'
      assign handle_cook_time = '20 mins'
      assign handle_total_time = '35 mins'
      assign handle_servings = '4 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Fasting / Vrat Food'
      assign handle_diet = 'Satvik / Gluten-Free'
      assign handle_chef_notes = 'Singhara (water chestnut) flour is completely gluten-free and brittle; dough will crack if made without potato. Always bind with boiled mashed potato and warm water for smooth, pliable puris.'
      assign handle_featured_product_handles = 'shinghoda-flour'
      assign handle_ingredients = '[For Puris & Halwa]||1.5 cups DV Gold Shinghoda (Water Chestnut) Flour||2 medium boiled potatoes (mashed smooth)||2 tbsp pure desi ghee||1 tsp sendha namak (rock salt)||1 green chilli (finely minced)||½ tsp roasted cumin powder||Warm water as needed for kneading||Desi ghee or groundnut oil for frying'
      assign handle_instructions = 'Singhare ki Puri: In a mixing bowl, combine 1.5 cups DV Gold Shinghoda Flour with smooth mashed potatoes, sendha namak, and 1 tsp ghee. Knead into a pliable, firm dough using warm water. Roll gently between greased sheets and deep-fry in hot ghee until puffed and golden for your Navratri thali.||Singhara Halwa: Melt 3 tbsp desi ghee in a heavy pan. Add 1 cup shinghoda flour and roast on medium-low flame until fragrant and golden-brown. Slowly stir in 1 cup warm milk/water and ½ cup jaggery or sugar syrup, stirring continuously until smooth, glossy, and leaves the sides of the pan.||Singhara Cheela: Whisk shinghoda flour with water, sendha namak, minced green chillies, and fresh coriander into a smooth batter. Pour a ladle onto a hot greased tawa, drizzle ghee around edges, and cook both sides until golden-crisp.||Farali Pakora Batter: Mix shinghoda flour with a spoonful of rajagro flour, rock salt, and spices to coat raw potato slices or paneer cubes before crisp-frying.'
    when 'sabudana-recipes', 'recipes/sabudana-recipes'
      assign handle_prep_time = '15 mins (+4 hrs soak)'
      assign handle_cook_time = '15 mins'
      assign handle_total_time = '30 mins'
      assign handle_servings = '4 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Fasting / Breakfast'
      assign handle_diet = 'Vegetarian / Gluten-Free'
      assign handle_chef_notes = 'Always rinse soaked sabudana under running cold water before cooking — this washes away excess surface starch so every pearl stays separate and never clumps or turns mushy.'
      assign handle_featured_product_handles = 'sabudana'
      assign handle_ingredients = '[Main Ingredients]||1 cup DV Gold Premium Sabudana (Tapioca Pearls)||½ cup roasted peanuts (coarsely crushed)||2 medium boiled potatoes (diced)||2 tbsp pure cow ghee or groundnut oil||1 tsp cumin seeds (jeera)||2 green chillies (slit)||8-10 fresh curry leaves||1 tsp sendha namak (rock salt)||1 tbsp fresh lemon juice||2 tbsp fresh coriander leaves'
      assign handle_instructions = 'Soaking Perfection: Rinse DV Gold Sabudana gently in cold water until water runs clear. Soak in just enough water to submerge pearls (water level ~½ inch above pearls) for 4–6 hours until soft and easily mashed between fingers.||Sabudana Khichdi: Heat ghee in a kadai. Splutter cumin seeds, curry leaves, and green chillies. Add diced boiled potatoes and saute for 2 minutes. Stir in the drained sabudana, roasted crushed peanuts, and sendha namak. Toss gently on low heat until pearls turn translucent. Finish with fresh lemon juice and coriander.||Sabudana Vada: Mix soaked sabudana with mashed boiled potatoes, coarse peanut powder, sendha namak, and green chillies. Shape into round patties and deep-fry in medium-hot peanut oil until crispy golden-brown.||Sabudana Kheer: Simmer soaked sabudana in 4 cups of full-cream milk with cardamom and sugar until glassy pearls float to the top. Garnish with slivered nuts.||Sabudana Thalipeeth: Combine soaked pearls with rajagro flour, mashed potato, and cumin. Flatten gently between parchment paper and pan-fry on a tawa with ghee until crisp on both sides.||Sabudana Papad: Steam seasoned sabudana batter with green chilli paste and sun-dry for homemade crispy farali papads.'
    when 'rajagaro-flour-recipes', 'recipes/rajagaro-flour-recipes'
      assign handle_prep_time = '10 mins'
      assign handle_cook_time = '20 mins'
      assign handle_total_time = '30 mins'
      assign handle_servings = '4 servings'
      assign handle_difficulty = 'Intermediate'
      assign handle_course = 'Fasting / Traditional Meal'
      assign handle_diet = 'Satvik / Gluten-Free'
      assign handle_chef_notes = 'Use Jhino (fine grind) for delicate khichdi, halwa, and lapshi; use Kakro (coarse grind) for rotlis, parathas, and farali thalipeeth to give superior texture and pleasant bite.'
      assign handle_featured_product_handles = 'rajagaro-jhino,rajagaro-kakro'
      assign handle_ingredients = '[Flour & Base]||1.5 cups DV Gold Rajagaro (Amaranth) Flour (Jhino or Kakro)||2 boiled potatoes (mashed smooth)||3 tbsp pure desi cow ghee||½ cup soaked sabudana (for khichdi)||1 tsp sendha namak (rock salt)||1 tsp cumin seeds (jeera)||1 tbsp roasted peanut crush||Warm water or milk as needed'
      assign handle_instructions = 'Rajagro ni Khichdi: Cook coarse (kakro) rajagro flour in ghee with cumin seeds, green chillies, soaked sabudana, and warm water. Simmer on low heat until cooked into a moist, wholesome farali khichdi.||Rajagro Rotli (Puri): Combine fine (jhino) rajagro flour with mashed potato, sendha namak, and a splash of warm water. Gently roll out rotlis on a tawa using ghee, or deep-fry for puffed golden farali puris.||Rajagro ni Lapshi: Heat 3 tbsp ghee in a pan, add coarse rajagro flour and roast until nutty and aromatic. Add boiling water or warm milk and jaggery, cooking until thick, glossy, and fragrant.||Farali Thalipeeth: Mix fine rajagro flour with mashed potato, coarsely crushed peanuts, sendha namak, and chopped coriander. Pat onto a greased pan and roast both sides with ghee until golden-crisp.||Rajagro Halwa: Roast fine rajagro flour in ghee on low heat. Add warm milk, cardamom powder, and sugar, stirring until smooth and prasad-style velvety.'
    when 'gum-powder-recipes', 'recipes/gum-powder-recipes'
      assign handle_prep_time = '20 mins'
      assign handle_cook_time = '25 mins'
      assign handle_total_time = '45 mins'
      assign handle_servings = '12-15 pieces'
      assign handle_difficulty = 'Intermediate'
      assign handle_course = 'Winter Superfood / Snack'
      assign handle_diet = 'Vegetarian / Ayurvedic'
      assign handle_chef_notes = 'Fry gond crystals on low-to-medium heat only! If ghee is too hot, the outside browns while the inside stays unpuffed and unpleasantly sticky. Low-heat frying expands gond crystals 3–4x into light, crispy puffs.'
      assign handle_featured_product_handles = 'gum-powder'
      assign handle_ingredients = '[For Gond Laddoos & Tonics]||½ cup DV Gold Edible Gum (Gond / Gum Powder)||½ cup pure desi cow ghee (for frying)||1 cup whole wheat flour or multi-grain atta||¾ cup organic jaggery (gud) or powdered sugar||¼ cup chopped mixed dry fruits (cashews, almonds, pistachios)||1 tsp DV Gold Dry Ginger Powder (sunth)||1 tsp green cardamom powder'
      assign handle_instructions = 'Puffing the Gond: Heat pure ghee in a heavy-bottomed kadai on medium-low flame. Add gond in small batches. Fry gently until each crystal puffs up completely into a crisp, popcorn-like sphere. Remove and drain; crush lightly once cool.||Gond Ke Laddoo: In the remaining ghee, roast wheat flour on low heat until golden and nutty. Mix in crushed puffed gond, roasted nuts, dry ginger powder, and melted warm jaggery. While still warm, roll into rich nourishing winter laddoos.||Gond Doodh: Stir 1-2 tsp of puffed crushed gond into warm milk flavored with cardamom and jaggery for a restorative, bone-strengthening nighttime beverage.||Gond Porridge: Stir puffed gond into warm dalia, rolled oats, or rice porridge with nuts and ghee for a comforting winter breakfast.||Gond Katira Cooler: Soak gond katira overnight in cold water until it expands into a translucent jelly. Stir into rose water, nimbu pani, or chilled milk for a natural body-cooling summer beverage.'
    when 'ganthoda-powder-recipes', 'recipes/ganthoda-powder-recipes'
      assign handle_prep_time = '5 mins'
      assign handle_cook_time = '10 mins'
      assign handle_total_time = '15 mins'
      assign handle_servings = '2 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Ayurvedic / Winter Tonic'
      assign handle_diet = 'Vegetarian / Health'
      assign handle_chef_notes = 'Ganthoda (Pipramul root) has an intense peppery bite. Always start with ¼ tsp per cup and gradually increase to taste. Never boil raw honey — stir in only after turning off the stove.'
      assign handle_featured_product_handles = 'ganthoda-powder'
      assign handle_ingredients = '[Ingredients]||1 tsp DV Gold Ganthoda (Pipramul) Powder||2 cups whole dairy or almond milk||1 tbsp organic jaggery (gud) or pure raw honey||¼ tsp cardamom powder||½ tsp pure desi cow ghee||Pinch of DV Gold Dry Ginger Powder'
      assign handle_instructions = 'Ganthoda Doodh (Night Elixir): Bring 2 cups of milk to a gentle simmer in a saucepan. Whisk in 1 tsp DV Gold Ganthoda Powder, cardamom, and a dollop of pure ghee. Simmer on low for 3 minutes. Turn off the heat, stir in jaggery, and serve warm before bedtime for restorative winter warmth.||Ganthoda-Elaichi Kadha: Warm water or milk with equal parts ganthoda powder and crushed cardamom pods for a gentle, fragrant digestive brew.||Winter Tri-Spice Tonic: Combine ¼ tsp ganthoda powder, ¼ tsp DV Gold ginger powder, and ¼ tsp turmeric in warm water or milk with honey to bolster seasonal immunity.||Ganthoda Ghee Shot: Mix ½ tsp ganthoda powder into 1 tbsp melted warm desi ghee with grated jaggery for a fast, time-honored Gujarati winter health spoonful.'
    when 'methi-powder-recipes', 'recipes/methi-powder-recipes'
      assign handle_prep_time = '15 mins'
      assign handle_cook_time = '30 mins'
      assign handle_total_time = '45 mins'
      assign handle_servings = '10-12 pieces'
      assign handle_difficulty = 'Intermediate'
      assign handle_course = 'Traditional Wellness / Snack'
      assign handle_diet = 'Vegetarian / Ayurvedic'
      assign handle_chef_notes = 'Always lightly roast methi powder in desi ghee before using in sweet recipes like laddoos — gentle heating transforms the bitterness into a warm, nutty, aromatic flavor.'
      assign handle_featured_product_handles = 'methi-powder'
      assign handle_ingredients = '[Ingredients]||2 tbsp DV Gold Pure Methi (Fenugreek) Powder||1 cup whole wheat flour (atta)||½ cup pure desi cow ghee||¾ cup organic jaggery (powdered)||2 tbsp puffed gond (edible gum)||1 tsp DV Gold Ginger Powder (sunth)||¼ cup chopped dry fruits (cashews, walnuts)'
      assign handle_instructions = 'Methi Ke Laddoo: Warm 2 tbsp ghee and briefly roast DV Gold Methi Powder on low flame to mellow its bitterness. In a separate kadai, roast wheat flour in ghee until golden. Combine roasted flour, toasted methi, puffed gond, dry ginger, dry fruits, and warm melted jaggery. Roll into tight nutrient-dense winter laddoos.||Methi Thepla: Add 1 tsp methi powder to whole wheat flour with curd, turmeric, sesame seeds, and chilli powder. Knead softly and roll thin for travel-ready Gujarati theplas.||Methi Paratha: Knead a pinch of methi powder with ajwain and ghee into your paratha dough for a crisp, digestive breakfast bread.||Methi Muthia: Steam savory dumplings made from gram flour (besan), methi powder, ginger-chilli paste, and spices; temper with mustard seeds and sesame.||Methi Dal Tadka: Bloom ½ tsp methi powder with cumin and garlic in hot ghee, then pour over simmering toor or moong dal for an aromatic bitter-sweet balance.'
    when 'ginger-powder-recipes', 'recipes/ginger-powder-recipes'
      assign handle_prep_time = '5 mins'
      assign handle_cook_time = '10 mins'
      assign handle_total_time = '15 mins'
      assign handle_servings = '2-4 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Beverage / Home Remedy'
      assign handle_diet = 'Vegetarian'
      assign handle_chef_notes = 'Pure dry ginger powder (sunth) is three times more concentrated than fresh ginger root. Start with just ¼ teaspoon per recipe to ensure perfectly balanced warmth.'
      assign handle_featured_product_handles = 'ginger-powder'
      assign handle_ingredients = '[Ingredients]||½ tsp DV Gold Sunth (Pure Ginger Powder)||2 cups fresh water or full cream milk||1 tbsp raw honey or jaggery||4-5 fresh tulsi leaves||2 whole black peppercorns (crushed)||1 whole clove (laung)'
      assign handle_instructions = 'Instant Adrak Chai: Boil water with DV Gold tea and stir in ¼ tsp DV Gold Ginger Powder per cup — gives authentic fresh adrak zest with zero grating or peeling required.||Homemade Kadha: Simmer ginger powder with tulsi leaves, crushed peppercorns, clove, and cinnamon in 2 cups of water until reduced by half. Strain and mix with raw honey for soothing cold relief.||Ginger Spice Cookies: Cream butter and jaggery with ½ tsp ginger powder, cinnamon, and wheat flour. Bake at 180°C for 12 minutes for crunchy winter biscuits.||Warm Ginger Rice: Toss steamed basmati rice in desi ghee with ¼ tsp ginger powder, cumin seeds, and roasted cashew nuts for a comforting fragrant side.||Morning Ginger Honey Shot: Dissolve ¼ tsp ginger powder in 1 tbsp pure honey and a squeeze of fresh lemon juice for an energizing morning digestive boost.'
    when 'dhana-jeeru-powder-recipes', 'recipes/dhana-jeeru-powder-recipes'
      assign handle_prep_time = '10 mins'
      assign handle_cook_time = '15 mins'
      assign handle_total_time = '25 mins'
      assign handle_servings = '4 servings'
      assign handle_difficulty = 'Easy'
      assign handle_course = 'Everyday Main / Curry'
      assign handle_diet = 'Vegetarian'
      assign handle_chef_notes = 'Add dhana jeeru powder midway through cooking rather than at the very end — it needs a minute in warm oil and vegetable moisture to blossom and mellow its earthiness.'
      assign handle_featured_product_handles = 'dhana-jeeru-powder'
      assign handle_ingredients = '[Ingredients]||2 tsp DV Gold Dhana Jeeru Powder (Coriander-Cumin Blend)||3 medium potatoes (boiled & cubed or sliced)||1.5 tbsp groundnut oil or ghee||½ tsp mustard seeds (rai)||½ tsp turmeric powder (haldi)||1 tsp Kashmiri red chilli powder||½ tsp hing (asafoetida)||Salt to taste and fresh coriander for garnish'
      assign handle_instructions = 'Everyday Gujarati Shaak: Heat oil in a pan, add mustard seeds and hing. Add chopped vegetables or boiled potatoes. Sprinkle 2 tsp DV Gold Dhana Jeeru, turmeric, and chilli powder. Toss well and cook covered for 8 minutes.||Crispy Batata Fry: Coat thinly sliced raw potatoes in dhana jeeru powder, rock salt, and chilli powder. Pan-fry in oil until edges turn delightfully crisp and golden.||Masala Khichdi: Stir 1 tsp dhana jeeru into moong dal and rice khichdi with ghee and roasted cumin for an instant wholesome one-pot dinner.||Stuffed Paratha Filling: Mix boiled mashed potatoes with chopped onions, fresh coriander, green chilli, and 1.5 tsp dhana jeeru powder for flavorful paratha stuffing.||Dhana Jeeru Sprinkle: Lightly toast the powder and dust over fresh thepla, fried snacks, or fafda as an aromatic finishing seasoning.'
    when 'dhana-powder-recipes', 'recipes/dhana-powder-recipes'
