<div class="section-background"></div>

<section
  class="section section--page-width home-faq spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if section.settings.heading != blank %}
    aria-labelledby="HomeFaqHeading-{{ section.id }}"
  {% else %}
    aria-label="Frequently asked questions"
  {% endif %}
>
  <div
    class="home-faq__inner{% if section.settings.heading != blank and section.blocks.size > 0 %} gap-style{% endif %}"
    {% if section.settings.heading != blank and section.blocks.size > 0 %}
      style="{% render 'gap-style', value: section.settings.gap %}"
    {% endif %}
  >
    {% if section.settings.heading != blank %}
      <h2 class="home-faq__heading h2" id="HomeFaqHeading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="home-faq__items">
        {% for block in section.blocks %}
          {% capture faq_content %}
            <details class="home-faq__item" {{ block.shopify_attributes }}>
              <summary class="home-faq__summary">
                <span>{{ block.settings.question | escape }}</span>
                <span class="home-faq__icon svg-wrapper icon-caret icon-animated" aria-hidden="true">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </summary>
              {% if block.settings.answer != blank %}
                <div class="home-faq__answer details-content rte">
                  {{ block.settings.answer }}
                </div>
              {% endif %}
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component', children: faq_content, close_with_escape: true %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-faq__inner {
    display: grid;
    width: 100%;
    max-width: var(--normal-content-width);
    margin-inline: auto;
  }

  .home-faq__inner.gap-style {
    gap: var(--gap);
  }

  .home-faq__heading {
    margin: 0;
    text-align: center;
    text-wrap: balance;
  }

  .home-faq__items {
    display: grid;
    gap: var(--gap-lg);
  }

  .home-faq__item {
    overflow: hidden;
    color: var(--color-foreground);
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-lg);
  }

  .home-faq__summary {
    display: flex;
    min-height: var(--minimum-touch-target);
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    padding: var(--padding-lg);
    background: var(--color-white);
    cursor: pointer;
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--md);
    line-height: var(--font-paragraph--line-height);
    list-style: none;
    text-wrap: pretty;
  }

  .home-faq__summary::-webkit-details-marker {
    display: none;
  }

  .home-faq__summary:focus-visible {
    outline: var(--focus-outline-width) solid currentColor;
    outline-offset: calc(-1 * var(--focus-outline-offset));
  }

  .home-faq__icon {
    flex: 0 0 auto;
    color: currentColor;
  }

  .home-faq__answer {
    padding-inline: var(--padding-lg);
    color: var(--color-foreground);
    background: var(--color-white);
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--lg);
    line-height: var(--font-paragraph--line-height);
    text-wrap: pretty;
  }

  .home-faq__item[open] .home-faq__answer {
    padding-block-end: var(--padding-lg);
  }

  @media (min-width: 750px) {
    .home-faq__summary {
      font-size: var(--font-size--lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq accordion-custom .details-content,
    .home-faq .icon-animated {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home FAQ",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 7,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Heading to questions gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Frequently asked question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add an answer to this question.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home FAQ",
      "settings": {
        "heading": "FAQs",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Global shipping & delivery",
            "answer": "<p>Share shipping destinations, delivery estimates, and tracking information here.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Product care guide",
            "answer": "<p>Explain how customers can care for and enjoy their purchase.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Ethical sourcing standards",
            "answer": "<p>Describe your sourcing standards and product quality commitments.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Wholesale accounts",
            "answer": "<p>Tell business customers how to contact you about wholesale opportunities.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
