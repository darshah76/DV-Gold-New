{% liquid
  assign current_product = closest.product | default: product
  assign judge_me_badge = current_product.metafields.judgeme.badge.value | default: current_product.metafields.judgeme.badge
  assign judge_me_widget = current_product.metafields.judgeme.widget.value | default: current_product.metafields.judgeme.widget
  assign rating = 0
  assign rating_count = 0

  if judge_me_badge contains "data-average-rating='"
    assign rating = judge_me_badge | split: "data-average-rating='" | last | split: "'" | first
    assign rating_count = judge_me_badge | split: "data-number-of-reviews='" | last | split: "'" | first
  elsif judge_me_badge contains 'data-average-rating="'
    assign rating = judge_me_badge | split: 'data-average-rating="' | last | split: '"' | first
    assign rating_count = judge_me_badge | split: 'data-number-of-reviews="' | last | split: '"' | first
  endif
%}

<div class="section-background"></div>

<section
  class="section section--page-width judgeme-reviews spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <judge-me-reviews
    class="judgeme-reviews__inner gap-style"
    data-autoplay-seconds="{{ section.settings.autoplay_seconds }}"
    data-featured-label="{{ section.settings.featured_label | escape }}"
    style="{% render 'gap-style', value: section.settings.gap %}"
  >
    <div class="judgeme-reviews__header-region">
      {% if section.settings.heading != blank %}
        <h2 class="judgeme-reviews__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <div class="judgeme-reviews__header">
        <div class="judgeme-reviews__summary" aria-label="{{ rating }} out of 5 stars from {{ rating_count }} reviews">
          <p class="judgeme-reviews__rating">{{ rating }}</p>
          <div class="judgeme-reviews__stars" aria-hidden="true" style="--rating-percent: {{ rating | times: 20 }}%;">
            <span class="judgeme-reviews__stars-base">★★★★★</span>
            <span class="judgeme-reviews__stars-fill">★★★★★</span>
          </div>
          <p class="judgeme-reviews__count">
            {{ section.settings.review_count_prefix | escape }} {{ rating_count }} {{ section.settings.review_count_suffix | escape }}
          </p>
        </div>

        <button class="button judgeme-reviews__write-button" type="button" data-judgeme-write-review>
          {{ section.settings.write_review_label | escape }}
        </button>
      </div>
    </div>

    <div
      id="judgeme_product_reviews"
      class="jdgm-widget jdgm-review-widget"
      data-id="{{ current_product.id }}"
    >
      {{ judge_me_widget }}
    </div>
  </judge-me-reviews>
</section>

<script src="{{ 'judgeme-reviews.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .judgeme-reviews {
    overflow: hidden;
    background: var(--color-background);
  }

  .judgeme-reviews__inner {
    position: relative;
    display: grid;
    width: 100%;
    min-width: 0;
    gap: var(--gap);
  }

  .judgeme-reviews__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-xl);
  }

  .judgeme-reviews__header-region {
    display: grid;
    gap: var(--gap-2xl);
  }

  .judgeme-reviews__heading {
    max-width: var(--max-width--heading-narrow);
    margin: 0 auto;
    color: var(--color-heading);
    font-family: var(--font-h2--family);
    font-style: var(--font-h2--style);
    font-weight: var(--font-h2--weight);
    font-size: var(--font-h2--size);
    line-height: var(--font-h2--line-height);
    letter-spacing: var(--font-h2--letter-spacing);
    text-align: center;
    text-wrap: balance;
  }

  .judgeme-reviews__summary {
    display: grid;
    justify-items: start;
    gap: var(--gap-xs);
  }

  .judgeme-reviews__rating {
    margin: 0;
    color: var(--color-foreground);
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: var(--font-size--4xl);
    line-height: 1;
  }

  .judgeme-reviews__stars {
    position: relative;
    width: max-content;
    font-size: var(--font-size--2xl);
    line-height: 1;
  }

  .judgeme-reviews__stars-base {
    color: var(--color-border);
  }

  .judgeme-reviews__stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--rating-percent);
    overflow: hidden;
    color: var(--color-heading);
    white-space: nowrap;
  }

  .judgeme-reviews__count {
    margin: 0;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--lg);
    line-height: var(--font-paragraph--line-height);
  }

  .judgeme-reviews__write-button {
    flex: none;
  }

  .judgeme-reviews .jdgm-widget {
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
  }

  .judgeme-reviews .jdgm-rev-widg {
    padding: 0;
    border: 0;
  }

  .judgeme-reviews .jdgm-rev-widg__header {
    width: 100%;
  }

  .judgeme-reviews .jdgm-rev-widg__title,
  .judgeme-reviews .jdgm-rev-widg__summary,
  .judgeme-reviews .jdgm-histogram {
    display: none;
  }

  .judgeme-reviews .jdgm-widget-actions-wrapper {
    display: none;
  }

  .judgeme-reviews .jdgm-rev-widg__summary-text,
  .judgeme-reviews .jdgm-rev__body > p {
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--lg);
    line-height: var(--font-paragraph--line-height);
    text-wrap: pretty;
  }

  .judgeme-reviews .jdgm-star,
  .judgeme-reviews .jdgm-rev-widg__summary-stars {
    color: var(--color-heading);
  }

  .judgeme-reviews .jdgm-write-rev-link {
    min-height: var(--minimum-touch-target);
  }

  .judgeme-reviews .jdgm-rev {
    position: relative;
    min-width: 0;
    padding: var(--padding-lg);
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-cards);
  }

  .judgeme-reviews .jdgm-rev.judgeme-reviews__review--featured {
    border-color: var(--color-heading);
  }

  .judgeme-reviews__featured-label {
    position: absolute;
    z-index: 1;
    inset-block-start: 0;
    inset-inline-start: 50%;
    max-width: calc(100% - var(--padding-xl) * 2);
    padding: var(--padding-2xs) var(--padding-lg);
    overflow: hidden;
    color: var(--color-primary-button-text);
    background: var(--color-primary-button-background);
    border-radius: var(--style-border-radius-pills);
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--sm);
    line-height: var(--font-paragraph--line-height);
    text-overflow: ellipsis;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .judgeme-reviews__pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-xs);
  }

  .judgeme-reviews__pagination-button {
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
    padding: 0;
    color: var(--color-border);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .judgeme-reviews__pagination-button::before {
    display: block;
    width: var(--padding-sm);
    height: var(--padding-sm);
    margin: auto;
    background: currentColor;
    border-radius: var(--style-border-radius-50);
    content: "";
  }

  .judgeme-reviews__pagination-button[aria-current="true"] {
    color: var(--color-heading);
  }

  .judgeme-reviews__pagination-button:focus-visible {
    outline: var(--focus-outline-width) solid currentColor;
    outline-offset: var(--focus-outline-offset);
  }

  .judgeme-reviews .jdgm-rev__author {
    color: var(--color-foreground);
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
  }

  .judgeme-reviews .jdgm-paginate__page {
    min-width: var(--minimum-touch-target);
    min-height: var(--minimum-touch-target);
  }

  @media (max-width: 749px) {
    .judgeme-reviews__header {
      flex-direction: column;
      align-items: center;
    }

    .judgeme-reviews__header-region {
      justify-items: center;
    }

    .judgeme-reviews__summary {
      justify-items: center;
      text-align: center;
    }

    .judgeme-reviews .jdgm-rev-widg__reviews {
      display: flex;
      gap: var(--gap-lg);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-inline: contain;
    }

    .judgeme-reviews .jdgm-rev-widg__reviews::-webkit-scrollbar {
      display: none;
    }

    .judgeme-reviews .jdgm-rev {
      flex: 0 0 calc(100% - var(--padding-3xl));
      scroll-snap-align: center;
      text-align: start;
    }
  }

  @media (min-width: 750px) {
    .judgeme-reviews__pagination {
      display: none;
    }

    .judgeme-reviews .jdgm-rev-widg__reviews {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-xl);
    }
  }

  @media (min-width: 990px) {
    .judgeme-reviews .jdgm-rev-widg__reviews {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .judgeme-reviews .jdgm-rev:nth-child(n + 5) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .judgeme-reviews .jdgm-rev-widg__reviews {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Judge.me reviews",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by tea lovers"
    },
    {
      "type": "text",
      "id": "write_review_label",
      "label": "Write review button",
      "default": "Write a review"
    },
    {
      "type": "text",
      "id": "review_count_prefix",
      "label": "Review count prefix",
      "default": "Based on"
    },
    {
      "type": "text",
      "id": "review_count_suffix",
      "label": "Review count suffix",
      "default": "reviews"
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Featured review label",
      "default": "Most loved"
    },
    {
      "type": "select",
      "id": "autoplay_seconds",
      "label": "Mobile auto-rotate interval",
      "options": [
        { "value": "5", "label": "5 seconds" },
        { "value": "7", "label": "7 seconds" }
      ],
      "default": "5"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Summary to reviews gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Judge.me reviews",
      "settings": {
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  ]
}
{% endschema %}
