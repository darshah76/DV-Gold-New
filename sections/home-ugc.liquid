<script src="{{ 'home-ugc.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% render 'quick-add-modal-styles' %}

<div class="section-background"></div>
<home-ugc
  class="section section--page-width home-ugc spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if section.settings.heading != blank %}aria-labelledby="HomeUgcHeading-{{ section.id }}"{% else %}aria-label="Watch and shop"{% endif %}
>
  <div class="home-ugc__inner gap-style" style="{% render 'gap-style', value: section.settings.gap %}">
    {% if section.settings.heading != blank %}
      <header class="home-ugc__header">
        <h2 class="home-ugc__heading h2" id="HomeUgcHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </header>
    {% endif %}

    <div class="home-ugc__track" data-ugc-track>
      {% for block in section.blocks %}
        {% liquid
          assign product = block.settings.product
          assign current_variant = product.selected_or_first_available_variant
        %}
        <product-card class="product-card home-ugc__card" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
          {% if product != blank %}
            <a class="product-card__link" ref="productCardLink" href="{{ product.url }}" aria-label="{{ product.title | escape }}"></a>
          {% endif %}

          <div class="home-ugc__media">
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '600x' }}
              <div class="home-ugc__video-controls">
                <button class="home-ugc__video-control" type="button" data-ugc-playback data-state="playing" aria-label="Pause video" aria-pressed="true">
                  <span class="home-ugc__icon home-ugc__icon--play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/><path d="M15.945 12.395c-.176.626-1.012 1.07-2.682 1.955-1.615.856-2.422 1.285-3.073 1.113a1.66 1.66 0 0 1-.712-.393C9 14.62 9 13.747 9 12s0-2.62.478-3.07c.198-.186.443-.321.712-.392.65-.173 1.458.256 3.073 1.112 1.67.886 2.506 1.329 2.682 1.955.073.259.073.531 0 .79Z"/></svg></span>
                  <span class="home-ugc__icon home-ugc__icon--pause" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/><path d="M9.5 9v6M14.5 9v6"/></svg></span>
                </button>
                <button class="home-ugc__video-control" type="button" data-ugc-volume data-state="muted" aria-label="Unmute video" aria-pressed="false">
                  <span class="home-ugc__icon home-ugc__icon--muted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M14 14.814V9.186c0-3.145 0-4.717-.925-5.109-.926-.391-2.015.721-4.193 2.945-1.128 1.152-1.771 1.407-3.376 1.407-1.403 0-2.105 0-2.61.344-1.046.714-.887 2.109-.887 3.227 0 1.118-.159 2.513.888 3.227.504.344 1.206.344 2.609.344 1.605 0 2.248.255 3.376 1.407 2.178 2.224 3.267 3.336 4.193 2.945.925-.392.925-1.964.925-5.109Z"/><path d="m18 10 4 4m-4 0 4-4"/></svg></span>
                  <span class="home-ugc__icon home-ugc__icon--unmuted" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M18 14.814V9.186c0-3.145 0-4.717-.926-5.109-.926-.391-2.016.721-4.195 2.945-1.129 1.152-1.773 1.407-3.379 1.407-1.112 0-2.473-.148-3.163.907C6 9.85 6 10.567 6 12s0 2.15.337 2.664c.69 1.055 2.051.907 3.163.907 1.606 0 2.25.255 3.379 1.407 2.179 2.224 3.269 3.336 4.195 2.945.926-.392.926-1.964.926-5.109Z"/></svg></span>
                </button>
              </div>
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'home-ugc__placeholder' }}
            {% endif %}
          </div>

          <div class="home-ugc__product">
            <div class="home-ugc__product-info">
              {% if product != blank %}
                {% if block.settings.show_title %}<a class="home-ugc__product-title h4" href="{{ product.url }}">{{ product.title | escape }}</a>{% endif %}
                {% if block.settings.show_price %}
                  <div class="home-ugc__prices">
                    <span class="home-ugc__price">{{ current_variant.price | money }}</span>
                    {% if block.settings.show_compare_price and current_variant.compare_at_price > current_variant.price %}
                      <s class="home-ugc__compare-price">{{ current_variant.compare_at_price | money }}</s>
                    {% endif %}
                  </div>
                {% endif %}
              {% else %}
                <p class="home-ugc__empty">Select a product</p>
              {% endif %}
            </div>
            {% if product != blank and product.available %}
              {% render 'quick-add', product: product, section_id: section.id, block: block, force_choose: true %}
            {% endif %}
          </div>
        </product-card>
      {% else %}
        <p class="home-ugc__empty">Add a video card to get started.</p>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="home-ugc__navigation" aria-label="Video carousel controls">
        <button class="button button-secondary home-ugc__arrow" type="button" data-ugc-previous aria-label="Previous videos">&larr;</button>
        <button class="button button-secondary home-ugc__arrow" type="button" data-ugc-next aria-label="Next videos">&rarr;</button>
      </div>
    {% endif %}
  </div>
</home-ugc>

{% stylesheet %}
  .home-ugc__inner { display: flex; flex-direction: column; }
  .home-ugc__header { text-align: center; }
  .home-ugc__heading { margin: 0; color: var(--color-heading); text-wrap: balance; }
  .home-ugc__track { display: grid; grid-auto-flow: column; grid-auto-columns: min(82vw, 20rem); gap: var(--gap-sm); overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: inline mandatory; scrollbar-width: none; padding-block-end: var(--padding-2xs); }
  .home-ugc__track::-webkit-scrollbar { display: none; }
  .home-ugc__card { position: relative; display: flex; flex-direction: column; min-width: 0; overflow: hidden; scroll-snap-align: start; background: var(--color-white); border: var(--style-border-width) solid var(--color-card-border-warm); border-radius: var(--style-border-radius-cards); box-shadow: var(--shadow-card-subtle); }
  .home-ugc__card > .product-card__link { position: absolute; inset: 0; z-index: 0; }
  .home-ugc__media { position: relative; aspect-ratio: 9 / 16; overflow: hidden; background: var(--color-background-tertiary); }
  .home-ugc__media video, .home-ugc__placeholder { width: 100%; height: 100%; display: block; object-fit: cover; }
  .home-ugc__video-controls { position: absolute; inset: var(--padding-sm) var(--padding-sm) auto; z-index: var(--layer-raised); display: flex; justify-content: space-between; pointer-events: none; }
  .home-ugc__video-control { display: grid; place-items: center; width: var(--minimum-touch-target); height: var(--minimum-touch-target); padding: 0; border: var(--style-border-width) solid var(--color-border); border-radius: var(--style-border-radius-50); background: var(--color-background); color: var(--color-foreground); box-shadow: var(--shadow-card-subtle); cursor: pointer; pointer-events: auto; }
  .home-ugc__video-control:focus-visible { outline: var(--focus-outline-width) solid currentColor; outline-offset: var(--focus-outline-offset); }
  .home-ugc__icon, .home-ugc__icon svg { display: block; width: var(--icon-size-md); height: var(--icon-size-md); }
  .home-ugc__icon path { stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  [data-ugc-playback][data-state='playing'] .home-ugc__icon--play, [data-ugc-playback][data-state='paused'] .home-ugc__icon--pause, [data-ugc-volume][data-state='muted'] .home-ugc__icon--unmuted, [data-ugc-volume][data-state='unmuted'] .home-ugc__icon--muted { display: none; }
  .home-ugc__product { position: relative; z-index: var(--layer-flat); display: flex; align-items: flex-end; justify-content: space-between; gap: var(--gap-sm); padding: var(--padding-lg); background: var(--color-white); }
  .home-ugc__product-info { display: flex; flex-direction: column; gap: var(--gap-2xs); min-width: 0; }
  .home-ugc__product-title { color: var(--color-foreground); text-decoration: none; text-wrap: pretty; }
  .home-ugc__prices { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--gap-xs); font-family: var(--font-body--family); font-style: var(--font-body--style); font-weight: var(--font-body--weight); line-height: var(--font-paragraph--line-height); }
  .home-ugc__price { color: var(--color-foreground); }
  .home-ugc__compare-price { color: var(--color-foreground-muted); }
  .home-ugc__product .quick-add { position: static; flex: 0 0 auto; width: var(--minimum-touch-target); height: var(--minimum-touch-target); }
  .home-ugc__product button.quick-add__button { position: static; display: grid; place-items: center; width: var(--minimum-touch-target); height: var(--minimum-touch-target); padding: 0; opacity: 1; border: var(--style-border-width) solid var(--color-primary-button-border); border-radius: var(--style-border-radius-buttons-primary); background: var(--color-primary-button-background); color: var(--color-primary-button-text); }
  .home-ugc__product .quick-add__button:is(:hover, :focus-visible) { width: var(--minimum-touch-target); background: var(--color-primary-button-hover-background); color: var(--color-primary-button-hover-text); border-color: var(--color-primary-button-hover-border); }
  .home-ugc__product .quick-add__button { font-size: 0; }
  .home-ugc__product .add-to-cart-icon { margin: 0; }
  .home-ugc__navigation { display: flex; justify-content: center; gap: var(--gap-sm); }
  .home-ugc__arrow.button { min-width: var(--minimum-touch-target); min-height: var(--minimum-touch-target); padding: 0; }
  .home-ugc__empty { margin: 0; color: var(--color-foreground-muted); }
  @media screen and (min-width: 750px) { .home-ugc__track { grid-auto-columns: min(38vw, 20rem); } }
  @media screen and (min-width: 1200px) { .home-ugc__track { grid-auto-columns: calc((100% - (var(--gap-sm) * 4)) / 5); } }
  @media (prefers-reduced-motion: reduce) { .home-ugc__track { scroll-behavior: auto; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Home UGC",
  "max_blocks": 25,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch & Shop" },
    { "type": "range", "id": "gap", "label": "Heading to videos gap", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "settings": [
        { "type": "video", "id": "video", "label": "Shopify-hosted video" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "checkbox", "id": "show_title", "label": "Show product title", "default": true },
        { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
        { "type": "checkbox", "id": "show_compare_price", "label": "Show compare-at price", "default": true, "visible_if": "{{ block.settings.show_price }}" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home UGC",
      "settings": { "heading": "Watch & Shop", "gap": 28, "padding-block-start": 48, "padding-block-end": 48 },
      "blocks": [ { "type": "video_card" }, { "type": "video_card" }, { "type": "video_card" }, { "type": "video_card" }, { "type": "video_card" } ]
    }
  ]
}
{% endschema %}
