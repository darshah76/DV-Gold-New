<div class="section-background"></div>

{% liquid
  assign has_content = false
  if section.blocks.size > 0 or section.settings.description != blank
    assign has_content = true
  endif
%}

<section
  class="section section--page-width home-certifications spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if section.settings.heading != blank %}
    aria-labelledby="HomeCertificationsHeading-{{ section.id }}"
  {% else %}
    aria-label="Certifications and registrations"
  {% endif %}
>
  <div
    class="home-certifications__container{% if section.settings.heading != blank and has_content %} gap-style{% endif %}"
    {% if section.settings.heading != blank and has_content %}
      style="{% render 'gap-style', value: section.settings.gap %}"
    {% endif %}
  >
    {% if section.settings.heading != blank %}
      <h2 class="home-certifications__heading h2" id="HomeCertificationsHeading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if has_content %}
      <div class="home-certifications__content">
        {% if section.blocks.size > 0 %}
          <ul class="home-certifications__cards" role="list">
            {% for block in section.blocks %}
              <li class="home-certifications__card" {{ block.shopify_attributes }}>
                {% if block.settings.logo != blank %}
                  <div class="home-certifications__logo-wrapper">
                    {{
                      block.settings.logo
                      | image_url: width: 320
                      | image_tag:
                        class: 'home-certifications__logo',
                        widths: '96, 144, 192, 240, 320',
                        sizes: '(min-width: 750px) 96px, 80px',
                        loading: 'lazy',
                        alt: block.settings.logo.alt
                    }}
                  </div>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="home-certifications__card-text">{{ block.settings.text | escape | newline_to_br }}</p>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="home-certifications__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-certifications__container {
    display: grid;
    width: 100%;
    max-width: var(--normal-content-width);
    margin-inline: auto;
    padding: var(--padding-2xl);
    color: var(--color-foreground);
    background: var(--color-background-secondary);
    border-radius: var(--style-border-radius-lg);
  }

  .home-certifications__container.gap-style {
    gap: var(--gap);
  }

  .home-certifications__heading {
    max-width: var(--max-width--heading-narrow);
    margin: 0 auto;
    text-align: center;
    text-wrap: balance;
  }

  .home-certifications__content {
    display: grid;
    gap: var(--gap-2xl);
  }

  .home-certifications__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-certifications__card {
    display: grid;
    min-width: 0;
    align-content: center;
    justify-items: center;
    gap: var(--gap-sm);
    padding: var(--padding-xl);
    text-align: center;
    background: var(--color-background-tertiary);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-lg);
  }

  .home-certifications__logo-wrapper {
    display: grid;
    width: 100%;
    height: calc(var(--padding-6xl) + var(--padding-xl));
    place-items: center;
  }

  .home-certifications__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .home-certifications__card-text {
    margin: 0;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--lg);
    line-height: var(--font-paragraph--line-height);
    text-wrap: pretty;
  }

  .home-certifications__description {
    max-width: var(--max-width--body-normal);
    margin-inline: auto;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-style: normal;
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--lg);
    line-height: var(--font-paragraph--line-height);
    text-align: center;
    text-wrap: pretty;
  }

  @media (min-width: 750px) {
    .home-certifications__container {
      padding: var(--padding-5xl);
    }

    .home-certifications__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap-2xl);
    }

    .home-certifications__card {
      padding: var(--padding-2xl) var(--padding-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home Certifications",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Certifications & registrations"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every product undergoes rigorous quality checks to ensure it meets our high standards. From sourcing to packaging, we maintain consistency, safety, and excellence at every step.</p>"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Heading to cards gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "certification",
      "name": "Certification",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Certification name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Certifications",
      "settings": {
        "heading": "Certifications & registrations",
        "description": "<p>Every product undergoes rigorous quality checks to ensure it meets our high standards. From sourcing to packaging, we maintain consistency, safety, and excellence at every step.</p>",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        {
          "type": "certification",
          "settings": {
            "text": "FSSAI certified"
          }
        },
        {
          "type": "certification",
          "settings": {
            "text": "ISO 9001 certified"
          }
        },
        {
          "type": "certification",
          "settings": {
            "text": "Registered & verified"
          }
        }
      ]
    }
  ]
}
{% endschema %}
