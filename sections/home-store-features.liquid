<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="section-background home-store-features__background"></div>

<section
  class="section section--full-width home-store-features spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  {% if section.blocks.size > 0 %}
    <marquee-component
      class="home-store-features__marquee"
      data-speed-factor="{{ section.settings.speed }}"
    >
      <div class="home-store-features__track" ref="wrapper">
        <ul class="home-store-features__list" ref="content" role="list">
          {% for block in section.blocks %}
            <li class="home-store-features__item" ref="marqueeItems[]" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                {{
                  block.settings.icon
                  | image_url: width: 192
                  | image_tag:
                    class: 'home-store-features__icon',
                    widths: '48, 72, 96, 144, 192',
                    sizes: '48px',
                    loading: 'lazy',
                    alt: ''
                }}
              {% endif %}

              {% if block.settings.text != blank %}
                <span class="home-store-features__text">{{ block.settings.text | escape }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </marquee-component>
  {% endif %}
</section>

{% stylesheet %}
  .home-store-features__background,
  .home-store-features {
    background: var(--color-primary-button-background);
  }

  .home-store-features__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
    color: var(--color-primary-button-text);
  }

  .home-store-features__track {
    display: flex;
    width: fit-content;
  }

  .home-store-features__list {
    display: flex;
    min-width: max-content;
    align-items: center;
    gap: var(--gap-2xl);
    margin: 0;
    padding-block: var(--padding-3xl);
    padding-inline: var(--padding-xl);
    list-style: none;
  }

  .home-store-features__item {
    display: flex;
    align-items: center;
    gap: var(--gap-2xl);
    white-space: nowrap;
  }

  .home-store-features__item::after {
    color: var(--color-primary-button-text);
    content: '✦';
    font-size: var(--font-size--3xl);
    line-height: 1;
  }

  .home-store-features__icon {
    display: block;
    flex: 0 0 auto;
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
    object-fit: contain;
  }

  .home-store-features__text {
    color: var(--color-primary-button-background);
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-h1--size);
    line-height: var(--font-h1--line-height);
    letter-spacing: var(--font-h1--letter-spacing);
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-store-features__marquee:not([data-disabled]) .home-store-features__track {
      animation: home-store-features-marquee var(--marquee-speed) linear infinite;
    }
  }

  @keyframes home-store-features-marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (min-width: 750px) {
    .home-store-features__list {
      gap: var(--gap-3xl);
      padding-block: var(--padding-4xl);
      padding-inline: var(--padding-3xl);
    }

    .home-store-features__item {
      gap: var(--gap-3xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home store features",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Store features",
      "info": "Describes this section to screen reader users."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Marquee speed",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "s",
      "default": 25,
      "info": "Lower values move faster."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Store feature"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home store features",
      "settings": {
        "accessibility_label": "Store features",
        "speed": 25,
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "100% natural"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "No added preservatives"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Proudly Indian"
          }
        }
      ]
    }
  ]
}
{% endschema %}
