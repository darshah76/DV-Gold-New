<div class="section-background"></div>

<section
  class="section section--page-width homepicked-masala spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if section.settings.heading != blank %}
    aria-labelledby="HomepickedMasalaHeading-{{ section.id }}"
  {% else %}
    aria-label="Homepicked masala and spices"
  {% endif %}
>
  <div class="homepicked-masala__layout gap-style" style="{% render 'gap-style', value: section.settings.gap %}">
    <div class="homepicked-masala__content">
      {% if section.settings.heading != blank %}
        <h2 class="homepicked-masala__heading h2" id="HomepickedMasalaHeading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="homepicked-masala__description rte">{{ section.settings.description }}</div>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        {% if section.settings.cta_link != blank %}
          <a class="button homepicked-masala__button" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label | escape }}
          </a>
        {% else %}
          <span class="button homepicked-masala__button" aria-disabled="true">
            {{ section.settings.cta_label | escape }}
          </span>
        {% endif %}
      {% endif %}
    </div>

    <div class="homepicked-masala__media">
      {% assign desktop_image = section.settings.image | default: section.settings.mobile_image %}
      {% if desktop_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.mobile_image | image_url: width: 320 }} 320w,
                {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
                {{ section.settings.mobile_image | image_url: width: 640 }} 640w,
                {{ section.settings.mobile_image | image_url: width: 750 }} 750w
              "
              sizes="calc((100vw - 56px) * 0.58)"
            >
          {% endif %}
          {{
            desktop_image
            | image_url: width: 2000
            | image_tag:
              class: 'homepicked-masala__image',
              widths: '320, 480, 640, 800, 1000, 1400, 1800, 2000',
              sizes: '(max-width: 749px) calc((100vw - 56px) * 0.58), (max-width: 1519px) calc((100vw - 108px) * 0.58), 812px',
              loading: 'lazy'
          }}
        </picture>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'homepicked-masala__image homepicked-masala__placeholder' }}
      {% endif %}

      <div class="homepicked-masala__particles" aria-hidden="true">
        {% for index in (1..6) %}
          {% assign particle_setting = 'particle_' | append: index %}
          {% assign particle = section.settings[particle_setting] %}
          {% if particle != blank %}
            {% assign particle_class = 'homepicked-masala__particle homepicked-masala__particle--' | append: index %}
            {{
              particle
              | image_url: width: 100
              | image_tag:
                class: particle_class,
                widths: '24, 32, 48, 64, 80, 100',
                sizes: '(max-width: 749px) 24px, 32px',
                loading: 'lazy',
                alt: ''
            }}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .homepicked-masala__layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--gap);
    align-items: center;
  }

  .homepicked-masala__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-xl);
    max-width: var(--narrow-content-width);
  }

  .homepicked-masala__heading {
    margin: 0;
    text-wrap: balance;
  }

  .homepicked-masala__description {
    max-width: var(--max-width--body-normal);
    color: var(--color-foreground-muted);
    text-wrap: pretty;
  }

  .homepicked-masala__description > * {
    margin-block: 0;
  }

  .homepicked-masala__button[aria-disabled='true'] {
    cursor: not-allowed;
    opacity: var(--opacity-50);
  }

  .homepicked-masala__media {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    overflow: hidden;
  }

  .homepicked-masala__image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    object-fit: contain;
  }

  .homepicked-masala__placeholder {
    color: var(--color-foreground-muted);
    background: var(--color-background);
  }

  .homepicked-masala__particles {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .homepicked-masala__particle {
    position: absolute;
    display: block;
    width: var(--font-size--2xl);
    height: var(--font-size--2xl);
    object-fit: contain;
    opacity: 0;
    transform-origin: center;
  }

  .homepicked-masala__particle--1 {
    inset-block-start: 8%;
    inset-inline-start: 10%;
    --particle-drift-x: var(--font-size--lg);
    --particle-drift-y: calc(-1 * var(--font-size--3xl));
    --particle-rotation: 190deg;
    --particle-duration: calc(var(--animation-speed-floating-particle) * 0.9);
    --particle-delay: calc(var(--animation-speed-floating-particle) * -0.45);
  }

  .homepicked-masala__particle--2 {
    inset-block-start: 15%;
    inset-inline-end: 8%;
    --particle-drift-x: calc(-1 * var(--font-size--2xl));
    --particle-drift-y: calc(-1 * var(--font-size--xl));
    --particle-rotation: -160deg;
    --particle-duration: calc(var(--animation-speed-floating-particle) * 1.15);
    --particle-delay: calc(var(--animation-speed-floating-particle) * -0.8);
  }

  .homepicked-masala__particle--3 {
    inset-block-start: 45%;
    inset-inline-end: 3%;
    --particle-drift-x: calc(-1 * var(--font-size--md));
    --particle-drift-y: calc(-1 * var(--font-size--3xl));
    --particle-rotation: 220deg;
    --particle-duration: calc(var(--animation-speed-floating-particle) * 1.3);
    --particle-delay: calc(var(--animation-speed-floating-particle) * -0.2);
  }

  .homepicked-masala__particle--4 {
    inset-block-end: 10%;
    inset-inline-end: 14%;
    --particle-drift-x: var(--font-size--xl);
    --particle-drift-y: calc(-1 * var(--font-size--2xl));
    --particle-rotation: -200deg;
    --particle-duration: calc(var(--animation-speed-floating-particle) * 1.05);
    --particle-delay: calc(var(--animation-speed-floating-particle) * -0.65);
  }

  .homepicked-masala__particle--5 {
    inset-block-end: 8%;
    inset-inline-start: 7%;
    --particle-drift-x: calc(-1 * var(--font-size--lg));
    --particle-drift-y: calc(-1 * var(--font-size--3xl));
    --particle-rotation: 170deg;
    --particle-duration: calc(var(--animation-speed-floating-particle) * 1.2);
    --particle-delay: calc(var(--animation-speed-floating-particle) * -0.35);
  }

  .homepicked-masala__particle--6 {
    inset-block-start: 42%;
    inset-inline-start: 4%;
    --particle-drift-x: var(--font-size--2xl);
    --particle-drift-y: calc(-1 * var(--font-size--xl));
    --particle-rotation: -230deg;
    --particle-duration: calc(var(--animation-speed-floating-particle) * 0.95);
    --particle-delay: calc(var(--animation-speed-floating-particle) * -1.05);
  }

  @media (min-width: 750px) {
    .homepicked-masala__particle {
      width: var(--font-size--3xl);
      height: var(--font-size--3xl);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .homepicked-masala__particle {
      animation: homepicked-masala-particle-float var(--particle-duration) var(--animation-easing) var(--particle-delay)
        infinite both;
      will-change: opacity, transform;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepicked-masala__particle {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes homepicked-masala-particle-float {
    0% {
      opacity: 0;
      transform: translate3d(0, var(--font-size--xl), 0) rotate(0deg) scale(0.2);
    }

    20% {
      opacity: 1;
      transform: translate3d(calc(var(--particle-drift-x) * 0.25), calc(var(--particle-drift-y) * 0.2), 0)
        rotate(calc(var(--particle-rotation) * 0.25)) scale(1);
    }

    50% {
      opacity: 0.9;
      transform: translate3d(calc(var(--particle-drift-x) * 0.65), calc(var(--particle-drift-y) * 0.65), 0)
        rotate(calc(var(--particle-rotation) * 0.6)) scale(1.1);
    }

    80% {
      opacity: 1;
      transform: translate3d(calc(var(--particle-drift-x) * 0.85), calc(var(--particle-drift-y) * 0.85), 0)
        rotate(calc(var(--particle-rotation) * 0.85)) scale(1);
    }

    100% {
      opacity: 0;
      transform: translate3d(var(--particle-drift-x), var(--particle-drift-y), 0) rotate(var(--particle-rotation)) scale(0.2);
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Homepicked Masala",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Handpicked Masala & Spices"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Short description",
      "default": "<p>Bring depth and warmth to every dish with carefully selected masalas and spices.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore all"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Also used on mobile when no mobile image is selected. Recommended aspect ratio: 4:3."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional image shown below 750px. Recommended aspect ratio: 4:3."
    },
    {
      "type": "header",
      "content": "Animated particles"
    },
    {
      "type": "paragraph",
      "content": "Upload 4–6 small transparent PNG images. Each particle uses a unique, responsive floating animation around the main image."
    },
    {
      "type": "image_picker",
      "id": "particle_1",
      "label": "Particle 1"
    },
    {
      "type": "image_picker",
      "id": "particle_2",
      "label": "Particle 2"
    },
    {
      "type": "image_picker",
      "id": "particle_3",
      "label": "Particle 3"
    },
    {
      "type": "image_picker",
      "id": "particle_4",
      "label": "Particle 4"
    },
    {
      "type": "image_picker",
      "id": "particle_5",
      "label": "Particle 5 (optional)"
    },
    {
      "type": "image_picker",
      "id": "particle_6",
      "label": "Particle 6 (optional)"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Content to image gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Homepicked Masala",
      "category": "Storytelling",
      "settings": {
        "heading": "Handpicked Masala & Spices",
        "description": "<p>Bring depth and warmth to every dish with carefully selected masalas and spices.</p>",
        "cta_label": "Explore all",
        "cta_link": "/collections/all",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  ]
}
{% endschema %}
