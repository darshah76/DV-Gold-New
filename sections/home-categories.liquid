<div class="section-background"></div>

<section
  class="section section--page-width home-categories spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if section.settings.title != blank %}
    aria-labelledby="HomeCategoriesTitle-{{ section.id }}"
  {% else %}
    aria-label="Home categories"
  {% endif %}
>
  <div
    class="home-categories__inner{% if section.settings.title != blank and section.blocks.size > 0 %} gap-style{% endif %}"
    {% if section.settings.title != blank and section.blocks.size > 0 %}
      style="{% render 'gap-style', value: section.settings.gap %}"
    {% endif %}
  >
    {% if section.settings.title != blank %}
      <h2 class="home-categories__title h2" id="HomeCategoriesTitle-{{ section.id }}">
        {{ section.settings.title | escape }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="home-categories__list" role="list">
        {% for block in section.blocks %}
          <li class="home-categories__item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a class="home-categories__card" href="{{ block.settings.link }}">
            {% else %}
              <div class="home-categories__card">
            {% endif %}

              <div class="home-categories__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'home-categories__image',
                      widths: '180, 240, 320, 480, 640, 900',
                      sizes: '(max-width: 749px) 38vw, (max-width: 1519px) calc((100vw - 140px) / 4), 335px',
                      loading: 'lazy'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'home-categories__image home-categories__placeholder' }}
                {% endif %}
              </div>

              {% if block.settings.name != blank %}
                <h3 class="home-categories__name h4">{{ block.settings.name | escape }}</h3>
              {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-categories__inner {
    display: grid;
  }

  .home-categories__title {
    margin: 0;
    text-wrap: balance;
  }

  .home-categories__list {
    display: flex;
    gap: var(--gap-md);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline proximity;
    scrollbar-width: none;
    list-style: none;
  }

  .home-categories__list::-webkit-scrollbar {
    display: none;
  }

  .home-categories__item {
    flex: 0 0 calc((100% - (var(--gap-md) * 2)) / 2.5);
    min-width: 0;
    scroll-snap-align: start;
  }

  .home-categories__card {
    display: grid;
    gap: var(--gap-md);
    height: 100%;
    padding: var(--padding-md);
    color: var(--color-foreground);
    background: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-lg);
    text-align: center;
    text-decoration: none;
  }

  .home-categories__media {
    aspect-ratio: 3 / 4;
    min-width: 0;
    overflow: hidden;
  }

  .home-categories__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .home-categories__placeholder {
    color: var(--color-foreground-muted);
    background: var(--color-background);
  }

  .home-categories__name {
    align-self: end;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    text-wrap: nowrap;
  }

  .home-categories__card:focus-visible {
    outline: var(--focus-outline-width) solid currentColor;
    outline-offset: var(--focus-outline-offset);
  }

  @media (min-width: 750px) {
    .home-categories__list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap-xl);
      overflow: visible;
      scroll-snap-type: none;
    }

    .home-categories__item {
      min-width: 0;
    }

    .home-categories__card {
      padding: var(--padding-lg);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-categories__card[href] {
      transition: border-color var(--animation-speed) var(--animation-timing-hover);
    }

    .home-categories__card[href]:hover {
      border-color: var(--color-foreground);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-categories__list {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home Categories",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Heading to categories gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Category name",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image",
          "info": "Recommended image aspect ratio: 3:4."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Categories",
      "settings": {
        "title": "Shop by category",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        {
          "type": "category",
          "settings": {
            "name": "Tea"
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Spices"
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Dry fruits"
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Snacks"
          }
        }
      ]
    }
  ]
}
{% endschema %}
