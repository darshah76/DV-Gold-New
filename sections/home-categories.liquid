<div class="section-background"></div>

<section
  class="section section--page-width home-categories spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.card_title_color != blank %}
      --home-categories-title-color: {{ section.settings.card_title_color }};
    {% endif %}
  "
  {% if section.settings.title != blank %}
    aria-labelledby="HomeCategoriesTitle-{{ section.id }}"
  {% else %}
    aria-label="Home categories"
  {% endif %}
>
  <div
    class="home-categories__inner{% if section.settings.title != blank and section.blocks.size > 0 %} gap-style{% endif %}"
    {% if section.settings.title != blank and section.blocks.size > 0 %}
      style="{% render 'gap-style', value: section.settings.gap %}"
    {% endif %}
  >
    {% if section.settings.title != blank %}
      <h2 class="home-categories__title h2" id="HomeCategoriesTitle-{{ section.id }}">
        {{ section.settings.title | escape }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="home-categories__list" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign panel_heading = block.settings.panel_heading | default: block.settings.name
            assign panel_link = block.settings.cta_link | default: block.settings.link
          %}
          <li
            class="home-categories__item"
            style="--home-categories-panel-background: {{ block.settings.panel_background }}; --home-categories-panel-text: {{ block.settings.panel_text_color }};"
            {{ block.shopify_attributes }}
          >
            <div class="home-categories__card">

              <div class="home-categories__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'home-categories__image',
                      widths: '180, 240, 320, 480, 640, 900',
                      sizes: '(max-width: 749px) 38vw, (max-width: 1519px) calc((100vw - 140px) / 4), 335px',
                      loading: 'lazy'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'home-categories__image home-categories__placeholder' }}
                {% endif %}
              </div>

              {% if block.settings.name != blank %}
                <h3 class="home-categories__name h4">{{ block.settings.name | escape }}</h3>
              {% endif %}

              {% if block.settings.link != blank %}
                <a
                  class="home-categories__card-link"
                  href="{{ block.settings.link }}"
                  aria-label="{{ block.settings.name | default: panel_heading | escape }}"
                ></a>
              {% endif %}

              <div class="home-categories__panel-content">
                {% if panel_heading != blank %}
                  <h3 class="home-categories__panel-heading h3">{{ panel_heading | escape }}</h3>
                {% endif %}

                {% if block.settings.panel_description != blank %}
                  <div class="home-categories__panel-description rte">
                    {{ block.settings.panel_description }}
                  </div>
                {% endif %}

                {% if block.settings.cta_text != blank and panel_link != blank %}
                  <a class="button home-categories__panel-button" href="{{ panel_link }}">
                    {{ block.settings.cta_text | escape }}
                  </a>
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-categories__inner {
    display: grid;
  }

  .home-categories__inner.gap-style {
    gap: var(--gap);
  }

  .home-categories__title {
    margin: 0;
    text-wrap: balance;
  }

  .home-categories__list {
    display: flex;
    gap: var(--gap-md);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline proximity;
    scrollbar-width: none;
    list-style: none;
  }

  .home-categories__list::-webkit-scrollbar {
    display: none;
  }

  .home-categories__item {
    flex: 0 0 calc((100% - (var(--gap-md) * 2)) / 2.5);
    min-width: 0;
    scroll-snap-align: start;
  }

  .home-categories__card {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    color: var(--color-foreground);
    background: var(--color-white);
    border: var(--style-border-width) solid var(--color-card-border-warm);
    border-radius: var(--style-border-radius-lg);
    box-shadow: var(--shadow-card-subtle);
    text-align: center;
    text-decoration: none;
  }

  .home-categories__card-link {
    position: absolute;
    z-index: 1;
    inset: 0;
  }

  .home-categories__media {
    aspect-ratio: 3 / 4;
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .home-categories__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-categories__placeholder {
    color: var(--color-foreground-muted);
    background: var(--color-background);
  }

  .home-categories__name {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    margin: 0;
    padding: var(--padding-lg);
    overflow: hidden;
    color: var(--home-categories-title-color, var(--color-foreground));
    text-overflow: ellipsis;
    text-wrap: nowrap;
  }

  .home-categories__card:focus-visible {
    outline: var(--focus-outline-width) solid currentColor;
    outline-offset: var(--focus-outline-offset);
  }

  .home-categories__card-link:focus-visible,
  .home-categories__panel-button:focus-visible {
    outline: var(--focus-outline-width) solid currentColor;
    outline-offset: var(--focus-outline-offset);
  }

  .home-categories__panel-content {
    display: none;
  }

  @media (min-width: 750px) {
    .home-categories__list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap-xl);
      overflow: visible;
      scroll-snap-type: none;
    }

    .home-categories__item {
      min-width: 0;
      aspect-ratio: 3 / 4;
    }

  }

  @media (min-width: 990px) and (hover: hover) and (pointer: fine) {
    .home-categories__item {
      position: relative;
      z-index: 0;
      transition: z-index 0s linear var(--animation-speed-category-panel);
    }

    .home-categories__card {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      width: 100%;
      transform-origin: center;
      transition:
        width var(--animation-speed-category-panel) var(--animation-timing-hover),
        inset-inline-start var(--animation-speed-category-panel) var(--animation-timing-hover),
        background-color var(--animation-speed-category-panel) var(--animation-timing-hover),
        border-color var(--animation-speed-category-panel) var(--animation-timing-hover);
    }

    .home-categories__media {
      margin-inline-start: 0;
      transition:
        width var(--animation-speed-category-panel) var(--animation-timing-hover),
        margin-inline-start var(--animation-speed-category-panel) var(--animation-timing-hover);
    }

    .home-categories__name {
      transition: opacity var(--animation-speed-category-panel) var(--animation-timing-hover);
    }

    .home-categories__panel-content {
      position: absolute;
      z-index: 2;
      inset-block: 0;
      inset-inline-start: 0;
      display: flex;
      width: 50%;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: var(--gap-md);
      padding: var(--padding-xl);
      color: var(--home-categories-panel-text, var(--color-foreground));
      text-align: start;
      visibility: hidden;
      opacity: 0;
      transform: translateX(calc(-1 * var(--padding-lg)));
      transition:
        opacity var(--animation-speed-category-panel) var(--animation-timing-hover),
        transform var(--animation-speed-category-panel) var(--animation-timing-hover),
        visibility 0s linear var(--animation-speed-category-panel);
    }

    .home-categories__panel-heading,
    .home-categories__panel-description {
      margin: 0;
      color: inherit;
    }

    .home-categories__panel-description {
      max-width: var(--max-width--body-normal);
      text-wrap: pretty;
    }

    .home-categories__item:is(:hover, :focus-within) {
      z-index: 3;
      transition-delay: 0s;
    }

    .home-categories__item:is(:hover, :focus-within) .home-categories__card {
      width: calc(400% + (var(--gap-xl) * 3));
      color: var(--home-categories-panel-text, var(--color-foreground));
      background: var(--home-categories-panel-background, var(--color-background-secondary));
      border-color: var(--color-foreground);
    }

    .home-categories__item:nth-child(2):is(:hover, :focus-within) .home-categories__card {
      inset-inline-start: calc(-100% - var(--gap-xl));
    }

    .home-categories__item:nth-child(3):is(:hover, :focus-within) .home-categories__card {
      inset-inline-start: calc(-200% - (var(--gap-xl) * 2));
    }

    .home-categories__item:nth-child(4):is(:hover, :focus-within) .home-categories__card {
      inset-inline-start: calc(-300% - (var(--gap-xl) * 3));
    }

    .home-categories__item:is(:hover, :focus-within) .home-categories__media {
      width: 50%;
      margin-inline-start: 50%;
    }

    .home-categories__item:is(:hover, :focus-within) .home-categories__name {
      opacity: 0;
    }

    .home-categories__item:is(:hover, :focus-within) .home-categories__panel-content {
      visibility: visible;
      opacity: 1;
      transform: translateX(0);
      transition-delay: 0s;
    }

    .home-categories__item:is(:hover, :focus-within) .home-categories__card-link {
      inset-inline-start: 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-categories__list {
      scroll-behavior: auto;
    }

    .home-categories__item,
    .home-categories__card,
    .home-categories__media,
    .home-categories__name,
    .home-categories__panel-content {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home Categories",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Heading to categories gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Category name",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image",
          "info": "Recommended image aspect ratio: 3:4."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        },
        {
          "type": "header",
          "content": "Desktop expanded panel"
        },
        {
          "type": "text",
          "id": "panel_heading",
          "label": "Headline",
          "info": "Defaults to the category name when left blank."
        },
        {
          "type": "richtext",
          "id": "panel_description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button label",
          "default": "Shop category"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link",
          "info": "Defaults to the category link when left blank."
        },
        {
          "type": "color",
          "id": "panel_background",
          "label": "Panel background",
          "default": "{{ settings.color_palette.background }}"
        },
        {
          "type": "color",
          "id": "panel_text_color",
          "label": "Panel text color",
          "default": "{{ settings.color_palette.foreground }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Categories",
      "settings": {
        "title": "Shop by category",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": [
        {
          "type": "category",
          "settings": {
            "name": "Tea"
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Spices"
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Dry fruits"
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Snacks"
          }
        }
      ]
    }
  ]
}
{% endschema %}
